#!/usr/bin/env bash

# Serialize nix-direnv evaluations across Zellij panes.
# Without this, every pane races to run `nix print-dev-env` simultaneously
# when the flake cache invalidates, causing nix store lock contention.
_nix_direnv_lock_hash="$(printf '%s' "$PWD" | nix hash file --type blake3 --base16 /dev/stdin)"
_nix_direnv_lock="${XDG_RUNTIME_DIR:-/tmp}/nix-direnv-${_nix_direnv_lock_hash}.lock"
if [[ -n ${DIRENV_IN_ENVRC:-} ]]; then
  exec {_nix_direnv_lock_fd}>"$_nix_direnv_lock"
  flock "$_nix_direnv_lock_fd"
fi

# Don't fan out devshell builds to remote builders (aspen1, aspen2, desktop).
# The devshell is for the local machine — substituters are fine, but building
# on remotes just adds SSH overhead and store lock contention.
# NIX_CONFIG doesn't work here — the daemon ignores client-side builders
# overrides. Passing --builders directly to nix print-dev-env via use_flake
# forces it through the daemon protocol.
use flake . --accept-flake-config --no-pure-eval --builders ""
