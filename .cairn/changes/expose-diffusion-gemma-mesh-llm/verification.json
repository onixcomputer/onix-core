    "extension_source": "import type { ExtensionAPI } from \"@oh-my-pi/pi-coding-agent\";\n\nexport default function meshModels(pi: ExtensionAPI) {\n\tpi.on(\"session_start\", async (_event, ctx) => {\n\t\t// Mesh membership changes faster than OMP's default 24-hour discovery cache.\n\t\t// Managed timers contain failures and are cleared when the session shuts down.\n\t\tctx.setInterval(() => ctx.modelRegistry.refreshDiscoverableProviders([\"mesh\"], \"online\"), 30_000);\n\t\tawait ctx.modelRegistry.refreshDiscoverableProviders([\"mesh\"], \"online\");\n\t});\n}\n",
