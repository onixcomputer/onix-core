# Collie bridge configuration (britton-desktop).
# Home Manager owns both this file and the herdr plugins config-dir copy; treat
# this as the source of truth. Keep COLLIE_TRUSTED_USER and COLLIE_PUBLIC_HOSTS
# in sync with the tailnet identity (tailscale status --json .Self / .User).
# The host owns publication. The managed controller rejects serve/unserve.
# Do not set COLLIE_SKIP_SERVE: Tailscale still supplies the trusted identity.
COLLIE_PORT=8787
COLLIE_HOST=127.0.0.1
COLLIE_TRUSTED_USER=brittonrobitzsch@gmail.com
COLLIE_PUBLIC_HOSTS=britton-desktop.bison-tailor.ts.net
COLLIE_MULTI_SESSION=1
# These session aliases use another host's filesystem, not the desktop's files.
COLLIE_REMOTE_SESSIONS=aspen3
