+
+fn merge_plugin_entries(
+    mutable_plugins: Vec<InstalledPluginInfo>,
+    static_plugins: Vec<InstalledPluginInfo>,
+) -> Vec<InstalledPluginInfo> {
+    let mut merged = std::collections::BTreeMap::new();
+    for plugin in mutable_plugins.into_iter().chain(static_plugins) {
+        merged.insert(plugin.plugin_id.clone(), plugin);
+    }
+    merged.into_values().collect()
+}
+
+fn load_static_plugins(path: Option<&Path>) -> Vec<InstalledPluginInfo> {
+    let Some(path) = path else {
+        return Vec::new();
+    };
+    match load_from_path_strict(path) {
+        Ok(plugins) => plugins,
+        Err(err) => {
+            warn!(path = %path.display(), err = %err, "failed to load static plugin registry");
+            Vec::new()
+        }
+    }
+}
+
+fn runtime_plugins(mutable_plugins: Vec<InstalledPluginInfo>) -> Vec<InstalledPluginInfo> {
+    let static_registry = static_registry_path();
+    runtime_plugins_from_path(mutable_plugins, static_registry.as_deref())
+}
+
+fn runtime_plugins_from_path(
+    mutable_plugins: Vec<InstalledPluginInfo>,
+    static_registry: Option<&Path>,
+) -> Vec<InstalledPluginInfo> {
+    merge_plugin_entries(mutable_plugins, load_static_plugins(static_registry))
+}
