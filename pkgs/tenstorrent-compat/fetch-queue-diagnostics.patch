+    fetch_queue_diagnostics.wait_calls.store(0, std::memory_order_relaxed);
+    fetch_queue_diagnostics.poll_iterations.store(0, std::memory_order_relaxed);
+    fetch_queue_diagnostics.total_wait_nanoseconds.store(0, std::memory_order_relaxed);
+    fetch_queue_diagnostics.maximum_wait_nanoseconds.store(0, std::memory_order_relaxed);
+}
+
+FetchQueueDiagnostics get_fetch_queue_diagnostics() {
+    return {
+        fetch_queue_diagnostics.reserve_calls.load(std::memory_order_relaxed),
+        fetch_queue_diagnostics.wait_calls.load(std::memory_order_relaxed),
+        fetch_queue_diagnostics.poll_iterations.load(std::memory_order_relaxed),
+        fetch_queue_diagnostics.total_wait_nanoseconds.load(std::memory_order_relaxed),
