 namespace {
 
+constexpr std::string_view kFetchQueueDiagnosticsEnvironment = "TT_METAL_FETCH_QUEUE_DIAGNOSTICS";
+constexpr std::string_view kEnabledEnvironmentValue = "1";
+
+struct FetchQueueDiagnosticCounters {
+    std::atomic<std::uint64_t> reserve_calls = 0;
+    std::atomic<std::uint64_t> wait_calls = 0;
+    std::atomic<std::uint64_t> poll_iterations = 0;
+    std::atomic<std::uint64_t> total_wait_nanoseconds = 0;
+    std::atomic<std::uint64_t> maximum_wait_nanoseconds = 0;
+};
+
+FetchQueueDiagnosticCounters fetch_queue_diagnostics;
+
+bool fetch_queue_diagnostics_enabled() {
+    static const bool enabled = [] {
+        const char* value = std::getenv(kFetchQueueDiagnosticsEnvironment.data());
+        return value != nullptr && std::string_view(value) == kEnabledEnvironmentValue;
+    }();
+    return enabled;
+}
+
+void update_maximum_wait(std::uint64_t wait_nanoseconds) {
+    std::uint64_t maximum = fetch_queue_diagnostics.maximum_wait_nanoseconds.load(std::memory_order_relaxed);
+    while (maximum < wait_nanoseconds &&
+           !fetch_queue_diagnostics.maximum_wait_nanoseconds.compare_exchange_weak(
+               maximum, wait_nanoseconds, std::memory_order_relaxed)) {
+    }
+}
