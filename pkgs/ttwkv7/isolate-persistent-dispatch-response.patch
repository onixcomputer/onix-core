+std::optional<std::filesystem::path> validate_dispatch_response_socket_path(
+    std::string_view configured) {
+    const std::filesystem::path path(configured);
+    sockaddr_un address{};
+    if (configured.empty() || !path.is_absolute() ||
+        path.string().starts_with("/nix/store/") ||
+        path.string().size() >= sizeof(address.sun_path)) {
+        return std::nullopt;
+    }
+    return path;
+}
+
+std::filesystem::path dispatch_response_socket_path() {
+    const char* configured =
+        std::getenv(kDispatchResponseSocketEnvironment.data());
+    if (configured == nullptr) {
+        throw std::runtime_error(
+            "persistent dispatch response socket path is not configured");
+    }
+    const auto path = validate_dispatch_response_socket_path(configured);
+    if (!path) {
+        throw std::runtime_error(
+            "persistent dispatch response socket path is invalid");
+    }
+    return *path;
+}
+
+class DispatchResponseChannel {
+  public:
+    explicit DispatchResponseChannel(const std::filesystem::path& path) {
+        descriptor_ = ::socket(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0);
+        if (descriptor_ < 0) {
+            throw std::runtime_error(
+                "persistent dispatch response socket creation failed");
+        }
+        sockaddr_un address{};
+        address.sun_family = AF_UNIX;
+        const std::string text = path.string();
+        if (text.size() >= sizeof(address.sun_path)) {
+            throw std::logic_error(
+                "validated dispatch response socket path length changed");
+        }
+        std::memcpy(address.sun_path, text.c_str(), text.size() + 1);
+        if (::connect(descriptor_, reinterpret_cast<sockaddr*>(&address),
+                      sizeof(address)) != 0) {
+            const int saved_errno = errno;
+            static_cast<void>(::close(descriptor_));
+            descriptor_ = -1;
+            throw std::runtime_error(
+                "persistent dispatch response socket connection failed: " +
+                std::to_string(saved_errno));
+        }
+    }
+
+    DispatchResponseChannel(const DispatchResponseChannel&) = delete;
+    DispatchResponseChannel& operator=(const DispatchResponseChannel&) = delete;
+
+    ~DispatchResponseChannel() {
+        if (descriptor_ >= 0) {
+            static_cast<void>(::close(descriptor_));
+        }
+    }
+
+    void write_response(std::span<const uint8_t> response) const {
+        std::size_t offset = 0;
+        while (offset < response.size()) {
+            const ssize_t produced = ::send(
+                descriptor_, response.data() + offset,
+                response.size() - offset, MSG_NOSIGNAL);
+            if (produced < 0 && errno == EINTR) {
+                continue;
+            }
+            if (produced <= 0) {
+                throw std::runtime_error(
+                    "persistent dispatch response channel write failed");
+            }
+            offset += static_cast<std::size_t>(produced);
+        }
+    }
+
+  private:
+    int descriptor_ = -1;
+};
