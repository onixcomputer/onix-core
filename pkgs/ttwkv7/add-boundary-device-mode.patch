+std::string read_bounded_regular_file(const std::filesystem::path& path,
+                                      std::size_t maximum_bytes) {
+    std::error_code error;
+    if (!std::filesystem::is_regular_file(path, error) || error) {
+        throw std::runtime_error("fixture path must be a readable regular file");
+    }
+    const std::uintmax_t file_size = std::filesystem::file_size(path, error);
+    if (error || file_size == 0 || file_size > maximum_bytes) {
+        throw std::runtime_error("fixture file size is outside the reviewed bound");
+    }
+    std::ifstream input(path, std::ios::binary);
+    if (!input) throw std::runtime_error("fixture file could not be opened");
+    std::ostringstream bytes;
+    bytes << input.rdbuf();
+    if (!input.good() && !input.eof()) {
+        throw std::runtime_error("fixture file could not be read completely");
+    }
+    return bytes.str();
+}
