+
+BoundaryJson runtime_arguments_json(const BoundaryCapture& capture) {
+    BoundaryJson arguments = BoundaryJson::array();
+    for (const auto& item : capture.runtime_arguments) {
+        arguments.push_back(BoundaryJson{
+            {"compute", item.compute},
+            {"reader", item.reader},
+            {"writer", item.writer},
+        });
+    }
+    return arguments;
+}
+
+void validate_runtime_argument_coverage(const BoundaryCapture& capture) {
+    if (capture.runtime_arguments.empty()) {
+        throw std::runtime_error("boundary runtime argument capture is empty");
+    }
+    uint32_t expected_start = 0;
+    for (const auto& arguments : capture.runtime_arguments) {
+        const uint32_t reader_start = arguments.reader[ttwkv7::decode_abi::index(
+            ttwkv7::decode_abi::ReaderArgument::InstanceStart)];
+        const uint32_t reader_end = arguments.reader[ttwkv7::decode_abi::index(
+            ttwkv7::decode_abi::ReaderArgument::InstanceEnd)];
+        const uint32_t compute_start = arguments.compute[ttwkv7::decode_abi::index(
+            ttwkv7::decode_abi::ComputeArgument::InstanceStart)];
+        const uint32_t compute_end = arguments.compute[ttwkv7::decode_abi::index(
+            ttwkv7::decode_abi::ComputeArgument::InstanceEnd)];
+        const uint32_t writer_start = arguments.writer[ttwkv7::decode_abi::index(
+            ttwkv7::decode_abi::WriterArgument::InstanceStart)];
+        const uint32_t writer_end = arguments.writer[ttwkv7::decode_abi::index(
+            ttwkv7::decode_abi::WriterArgument::InstanceEnd)];
+        if (reader_start != expected_start || compute_start != reader_start ||
+            writer_start != reader_start || compute_end != reader_end ||
+            writer_end != reader_end || reader_end <= reader_start) {
+            throw std::runtime_error("boundary runtime argument ranges are not contiguous");
+        }
+        expected_start = reader_end;
+    }
+    if (expected_start != ttwkv7::boundary_device::kHeadCount) {
+        throw std::runtime_error("boundary runtime arguments do not cover all heads");
+    }
+}
