+bool validate_expected_writer_extraction(
+    const ttwkv7::boundary_device::Fixture& fixture, const HostShape& shape) {
+    const auto layout = ttwkv7::host_layout::derive_writer_layout(
+        shape, ttwkv7::boundary_device::kSequenceCount,
+        ttwkv7::boundary_device::kTokenCount);
+    if (!layout || layout->padded_rows != ttwkv7::boundary_device::kWriterRowCount) {
+        return false;
+    }
+    std::vector<uint16_t> writer(ttwkv7::boundary_device::kWriterElementCount, 0);
+    std::size_t output_source = 0;
+    std::size_t state_source = 0;
+    for (uint32_t head = 0; head < shape.head_count; ++head) {
+        for (uint32_t dimension = 0; dimension < shape.head_size; ++dimension) {
+            const auto index = ttwkv7::host_layout::writer_output_index(
+                *layout, shape, 0, 0, head, dimension,
+                ttwkv7::boundary_device::kTokenCount);
+            if (!index || *index >= writer.size()) return false;
+            writer[*index] = fixture.expected_output.bits[output_source++];
+        }
+        for (uint32_t row = 0; row < shape.head_size; ++row) {
+            for (uint32_t column = 0; column < shape.head_size; ++column) {
+                const auto index = ttwkv7::host_layout::writer_state_index(
+                    *layout, shape, 0, head, row, column,
+                    ttwkv7::boundary_device::kSequenceCount);
+                if (!index || *index >= writer.size()) return false;
+                writer[*index] = fixture.expected_post_state.bits[state_source++];
+            }
+        }
+    }
+    if (output_source != fixture.expected_output.bits.size() ||
+        state_source != fixture.expected_post_state.bits.size()) {
+        return false;
+    }
+
+    std::vector<uint16_t> extracted_output;
+    std::vector<uint16_t> extracted_state;
+    extracted_output.reserve(output_source);
+    extracted_state.reserve(state_source);
+    for (uint32_t head = 0; head < shape.head_count; ++head) {
+        for (uint32_t dimension = 0; dimension < shape.head_size; ++dimension) {
+            const auto index = ttwkv7::host_layout::writer_output_index(
+                *layout, shape, 0, 0, head, dimension,
+                ttwkv7::boundary_device::kTokenCount);
+            if (!index) return false;
+            extracted_output.push_back(writer[*index]);
+        }
+        for (uint32_t row = 0; row < shape.head_size; ++row) {
+            for (uint32_t column = 0; column < shape.head_size; ++column) {
+                const auto index = ttwkv7::host_layout::writer_state_index(
+                    *layout, shape, 0, head, row, column,
+                    ttwkv7::boundary_device::kSequenceCount);
+                if (!index) return false;
+                extracted_state.push_back(writer[*index]);
+            }
+        }
+    }
+    return extracted_output == fixture.expected_output.bits &&
+           extracted_state == fixture.expected_post_state.bits;
+}
