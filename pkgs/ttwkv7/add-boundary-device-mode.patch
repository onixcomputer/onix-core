+std::filesystem::path create_boundary_artifact_root(
+    const std::filesystem::path& root) {
+    if (!root.is_absolute() || root.string().starts_with("/nix/store/")) {
+        throw std::invalid_argument(
+            "boundary artifact root must be absolute and outside /nix/store");
+    }
+    std::error_code error;
+    if (std::filesystem::exists(root, error) || error ||
+        !std::filesystem::create_directory(root, error) || error) {
+        throw std::runtime_error(
+            "boundary artifact root must be a new creatable directory");
+    }
+    return root;
+}
