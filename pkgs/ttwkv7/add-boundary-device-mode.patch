+std::vector<uint16_t> bf16_bits(const std::vector<bfloat16>& values) {
+    std::vector<uint16_t> bits;
+    bits.reserve(values.size());
+    for (const bfloat16 value : values) bits.push_back(std::bit_cast<uint16_t>(value));
+    return bits;
+}
+
+std::vector<uint16_t> bf16_bits(const std::vector<float>& values) {
+    std::vector<uint16_t> bits;
+    bits.reserve(values.size());
+    for (const float value : values) bits.push_back(std::bit_cast<uint16_t>(bfloat16(value)));
+    return bits;
+}
