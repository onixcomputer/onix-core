+int run_boundary_self_test(const std::filesystem::path& fixture_path) {
+    const std::string fixture_bytes =
+        read_bounded_regular_file(fixture_path, kMaximumFixtureFileBytes);
+    const auto fixture = ttwkv7::boundary_device::parse_fixture(fixture_bytes);
+    if (!ttwkv7::boundary_device::self_test(fixture)) {
+        throw std::runtime_error("boundary pure core self-test failed");
+    }
+    const auto maybe_shape = derive_host_shape(
+        ttwkv7::boundary_device::kHeadSize,
+        ttwkv7::boundary_device::kHeadCount);
+    if (!maybe_shape) throw std::logic_error("boundary shape is invalid");
+    const HostShape shape = *maybe_shape;
+    for (const auto& input : fixture.inputs) {
+        const auto tiled = build_native_input(
+            input.values, shape, ttwkv7::boundary_device::kTokenCount,
+            ttwkv7::boundary_device::kSequenceCount);
+        const std::size_t expected_elements =
+            static_cast<std::size_t>(shape.padded_head_count) * shape.head_size;
+        if (tiled.size() != expected_elements) {
+            throw std::runtime_error("boundary input host preparation failed");
+        }
+    }
+    const auto state_matrix = ttwkv7::host_layout::build_state_upload_matrix(
+        fixture.pre_state.values, shape,
+        ttwkv7::boundary_device::kSequenceCount,
+        ttwkv7::boundary_device::kPaddedHeadCount);
+    if (!state_matrix || !validate_expected_writer_extraction(fixture, shape)) {
+        throw std::runtime_error("boundary state or writer preparation failed");
+    }
+
+    const BoundaryJson receipt{
+        {"device_initialized", false},
+        {"fixture_blake3", fixture.file_blake3},
+        {"nmse_ceiling", ttwkv7::boundary_device::kBoundaryNmseCeiling},
+        {"ordered_artifact_blake3", fixture.ordered_artifact_blake3},
+        {"schema_version", ttwkv7::boundary_device::kSchemaVersion},
+        {"self_test_passed", true},
+        {"target", kBoundaryTarget},
+        {"workload_enqueue_count", 0},
+    };
+    std::printf("%s\n", receipt.dump().c_str());
+    return 0;
+}
