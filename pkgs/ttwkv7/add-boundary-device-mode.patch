+std::string artifact_manifest(
+    const std::array<ttwkv7::boundary_device::ArtifactEvidence,
+                     kBoundaryEvidenceArtifactCount>& artifacts) {
+    std::ostringstream manifest;
+    manifest << "role\tfilename\telements\tbytes\tblake3\n";
+    const auto& output = artifacts[kBoundaryOutputArtifactIndex];
+    const auto& post_state = artifacts[kBoundaryPostStateArtifactIndex];
+    const auto& writer_raw = artifacts[kBoundaryWriterRawArtifactIndex];
+    manifest << output.role << '\t' << kBoundaryOutputFilename << '\t'
+             << output.element_count << '\t' << output.byte_count << '\t'
+             << output.blake3 << '\n';
+    manifest << post_state.role << '\t' << kBoundaryPostStateFilename << '\t'
+             << post_state.element_count << '\t' << post_state.byte_count
+             << '\t' << post_state.blake3 << '\n';
+    manifest << writer_raw.role << '\t' << kBoundaryWriterRawFilename << '\t'
+             << writer_raw.element_count << '\t' << writer_raw.byte_count
+             << '\t' << writer_raw.blake3 << '\n';
+    return manifest.str();
+}
