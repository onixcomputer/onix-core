+constexpr std::string_view kDispatchServerSummaryEnvironment =
+    "RWKV_TTWKV7_DISPATCH_SERVER_SUMMARY";
+constexpr std::string_view kDispatchServerTarget =
+    "rwkv_ttwkv7_persistent_dispatch_server";
+constexpr std::size_t kDispatchDeviceOpenCount = 1;
+constexpr pid_t kInitProcessId = 1;
+constexpr int kParentDeathSignal = SIGKILL;
+constexpr std::size_t kDispatchWorkloadEnqueueCount =
+    ttwkv7::dispatch_transport::kExpectedCallCount;
+
+std::filesystem::path dispatch_summary_path() {
+    const char* configured =
+        std::getenv(kDispatchServerSummaryEnvironment.data());
+    if (configured == nullptr || configured[0] == '\0') {
+        throw std::runtime_error(
+            "persistent dispatch server summary path is not configured");
+    }
+    const std::filesystem::path path(configured);
+    if (!path.is_absolute() || path.string().starts_with("/nix/store/")) {
+        throw std::runtime_error(
+            "persistent dispatch server summary path must be absolute and outside /nix/store");
+    }
+    std::error_code error;
+    const auto parent = path.parent_path();
+    if (parent.empty() || !std::filesystem::is_directory(parent, error) || error ||
+        std::filesystem::exists(path, error) || error) {
+        throw std::runtime_error(
+            "persistent dispatch server summary path must be new under an existing directory");
+    }
+    return path;
+}
+
+std::vector<uint8_t> read_dispatch_request() {
+    std::vector<uint8_t> request(
+        ttwkv7::dispatch_transport::kRequestFrameByteCount);
+    std::size_t offset = 0;
+    while (offset < request.size()) {
+        const std::size_t consumed = std::fread(
+            request.data() + offset, 1, request.size() - offset, stdin);
+        if (consumed == 0) {
+            if (std::ferror(stdin) != 0) {
+                throw std::runtime_error(
+                    "persistent dispatch request stream read failed");
+            }
+            throw std::runtime_error(
+                "persistent dispatch request stream ended before a complete frame");
+        }
+        offset += consumed;
+    }
+    return request;
+}
+
+void write_dispatch_response(std::span<const uint8_t> response) {
+    std::size_t offset = 0;
+    while (offset < response.size()) {
+        const std::size_t produced = std::fwrite(
+            response.data() + offset, 1, response.size() - offset, stdout);
+        if (produced == 0) {
+            throw std::runtime_error(
+                "persistent dispatch response stream write failed");
+        }
+        offset += produced;
+    }
+    if (std::fflush(stdout) != 0) {
+        throw std::runtime_error(
+            "persistent dispatch response stream flush failed");
+    }
+}
+
+BoundaryJson dispatch_summary_json(
+    const ttwkv7::dispatch_transport::SessionSummary& summary,
+    const std::vector<std::string>& runtime_argument_blake3) {
+    return BoundaryJson{
+        {"call_count", summary.call_count},
+        {"device_open_count", kDispatchDeviceOpenCount},
+        {"ordered_request_blake3", summary.ordered_request_blake3},
+        {"ordered_response_blake3", summary.ordered_response_blake3},
+        {"production_source_blake3", BoundaryJson{
+            {"decode_compute", kDecodeComputeSourceBlake3},
+            {"decode_reader", kDecodeReaderSourceBlake3},
+            {"writer", kWriterSourceBlake3},
+        }},
+        {"request_frame_byte_count", summary.request_frame_byte_count},
+        {"response_frame_byte_count", summary.response_frame_byte_count},
+        {"runtime_argument_blake3", runtime_argument_blake3},
+        {"same_layer_state_continuity_count",
+         summary.same_layer_state_continuity_count},
+        {"schema_version", ttwkv7::dispatch_transport::kSchemaVersion},
+        {"target", kDispatchServerTarget},
+        {"terminal_state", "closed"},
+        {"transcript_blake3", summary.transcript_blake3},
+        {"workload_enqueue_count", kDispatchWorkloadEnqueueCount},
+    };
+}
+
+} // namespace
