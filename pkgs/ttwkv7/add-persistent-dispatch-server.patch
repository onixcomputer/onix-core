+ttwkv7::dispatch_transport::ResponsePayload cpu_dispatch_payload(
+    const ttwkv7::dispatch_transport::RequestFrame& request) {
+    const auto fixture = ttwkv7::dispatch_transport::invocation_fixture(request);
+    const auto& a = fixture.inputs[0].values;
+    const auto& w = fixture.inputs[1].values;
+    const auto& k = fixture.inputs[2].values;
+    const auto& v = fixture.inputs[3].values;
+    const auto& r = fixture.inputs[4].values;
+    const auto& b = fixture.inputs[5].values;
+    std::vector<float> output;
+    std::vector<float> post_state;
+    output.reserve(ttwkv7::dispatch_transport::kHiddenSize);
+    post_state.reserve(ttwkv7::dispatch_transport::kStateElementCount);
+    for (std::size_t head = 0;
+         head < ttwkv7::dispatch_transport::kHeadCount; ++head) {
+        const SeqRef result = seq_ref_inst(
+            0, static_cast<int64_t>(head),
+            ttwkv7::dispatch_transport::kHeadSize,
+            ttwkv7::dispatch_transport::kHeadCount,
+            ttwkv7::boundary_device::kTokenCount,
+            ttwkv7::dispatch_transport::kHiddenSize, r, w, k, v, a, b,
+            fixture.pre_state.values);
+        output.insert(output.end(), result.Out.begin(), result.Out.end());
+        post_state.insert(post_state.end(), result.Sfinal.begin(),
+                          result.Sfinal.end());
+    }
+    return ttwkv7::dispatch_transport::ResponsePayload{
+        .raw_output_bits = bf16_bits(output),
+        .post_state_bits = bf16_bits(post_state),
+    };
+}
+
+int run_dispatch_server_self_test() {
+    if (!ttwkv7::dispatch_transport::self_test()) {
+        throw std::runtime_error(
+            "persistent dispatch transport self-test failed");
+    }
+    std::printf("persistent ttWKV7 dispatch server self-test: PASS\n");
+    return 0;
+}
+
+int run_dispatch_frame_self_test() {
+    const std::vector<uint8_t> request_bytes = read_dispatch_request();
+    const int trailing = std::fgetc(stdin);
+    if (trailing != EOF || std::ferror(stdin) != 0) {
+        throw std::runtime_error(
+            "dispatch frame self-test request contains trailing data");
+    }
+    const auto request =
+        ttwkv7::dispatch_transport::parse_request_frame(request_bytes);
+    const auto payload = cpu_dispatch_payload(request);
+    const std::vector<uint8_t> response =
+        ttwkv7::dispatch_transport::encode_response_frame(
+            request, request_bytes, payload);
+    write_dispatch_response(response);
+    return 0;
+}
+
+int run_dispatch_server() {
+    const pid_t expected_parent = ::getppid();
+    if (expected_parent == kInitProcessId ||
+        ::prctl(PR_SET_PDEATHSIG, kParentDeathSignal) != 0 ||
+        ::getppid() != expected_parent) {
+        throw std::runtime_error(
+            "persistent dispatch server could not bind parent-death cleanup");
+    }
+    const std::filesystem::path summary_path = dispatch_summary_path();
+    ttwkv7::dispatch_transport::DispatchSessionCore session;
+    std::vector<uint8_t> request_bytes = read_dispatch_request();
+    auto request = session.accept_request(request_bytes);
+    const auto shape = derive_host_shape(
+        ttwkv7::dispatch_transport::kHeadSize,
+        ttwkv7::dispatch_transport::kHeadCount);
+    if (!shape) {
+        throw std::logic_error("persistent dispatch host shape is invalid");
+    }
+    auto device = distributed::MeshDevice::create_unit_mesh(0);
+    std::vector<std::string> runtime_argument_blake3;
+    runtime_argument_blake3.reserve(
+        ttwkv7::dispatch_transport::kExpectedCallCount);
+    for (std::size_t call = 0;
+         call < ttwkv7::dispatch_transport::kExpectedCallCount; ++call) {
+        if (call != 0) {
+            request_bytes = read_dispatch_request();
+            request = session.accept_request(request_bytes);
+        }
+        const auto fixture =
+            ttwkv7::dispatch_transport::invocation_fixture(request);
+        BoundaryCapture capture;
+        static_cast<void>(run_wkv7(
+            device, Kernel::DecodeL, *shape,
+            ttwkv7::boundary_device::kTokenCount,
+            ttwkv7::boundary_device::kSequenceCount, true, nullptr, nullptr,
+            nullptr, nullptr, &fixture, kBoundaryOneShotExecutionPolicy,
+            &capture));
+        validate_runtime_argument_coverage(capture);
+        if (capture.output.size() !=
+                ttwkv7::dispatch_transport::kHiddenSize ||
+            capture.post_state.size() !=
+                ttwkv7::dispatch_transport::kStateElementCount) {
+            throw std::runtime_error(
+                "persistent dispatch capture element count mismatch");
+        }
+        const BoundaryJson arguments = runtime_arguments_json(capture);
+        runtime_argument_blake3.push_back(
+            ttwkv7::boundary_device::blake3_hex(arguments.dump()));
+        const ttwkv7::dispatch_transport::ResponsePayload payload{
+            .raw_output_bits = capture.output,
+            .post_state_bits = capture.post_state,
+        };
+        const std::vector<uint8_t> response =
+            session.record_response(request, request_bytes, payload);
+        write_dispatch_response(response);
+    }
+    const int trailing = std::fgetc(stdin);
+    if (trailing != EOF || std::ferror(stdin) != 0) {
+        throw std::runtime_error(
+            "persistent dispatch request stream contains trailing data");
+    }
+    const auto summary = session.finish();
+    const BoundaryJson receipt =
+        dispatch_summary_json(summary, runtime_argument_blake3);
+    write_text(summary_path, receipt.dump() + "\n");
+    return 0;
+}
