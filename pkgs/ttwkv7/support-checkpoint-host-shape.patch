+std::vector<float> build_native_input(const std::vector<float>& input,
+                                      const HostShape& shape,
+                                      uint32_t token_count,
+                                      uint32_t sequence_count) {
+    const uint64_t expected_elements = static_cast<uint64_t>(sequence_count) * token_count *
+                                       shape.head_count * shape.head_size;
+    if (input.size() != expected_elements) return {};
+
+    std::vector<float> tiled;
+    tiled.reserve(static_cast<size_t>(sequence_count) * token_count *
+                  shape.padded_head_count * shape.head_size);
+    for (uint32_t sequence = 0; sequence < sequence_count; sequence++) {
+        for (uint32_t token = 0; token < token_count; token++) {
+            std::vector<float> block(static_cast<size_t>(shape.padded_head_count) * shape.head_size, 0.0f);
+            for (uint32_t head = 0; head < shape.head_count; head++) {
+                for (uint32_t dimension = 0; dimension < shape.head_size; dimension++) {
+                    const size_t source =
+                        ((static_cast<size_t>(sequence) * token_count + token) * shape.head_count + head) *
+                            shape.head_size +
+                        dimension;
+                    block[static_cast<size_t>(head) * shape.head_size + dimension] = input[source];
+                }
+            }
+            auto converted = tilize(block, shape.padded_head_count, shape.head_size);
+            tiled.insert(tiled.end(), converted.begin(), converted.end());
+        }
+    }
+    return tiled;
+}
+
+bool run_checkpoint_shape_self_test() {
+    const std::string checkpoint_head_text = std::to_string(kCheckpointHeadCount);
+    const auto parsed_checkpoint_heads = parse_positive_u32(checkpoint_head_text);
+    if (!parsed_checkpoint_heads || *parsed_checkpoint_heads != kCheckpointHeadCount) return false;
+    const auto maybe_default_shape = derive_host_shape(kDefaultHeadSize, kDefaultHeadCount);
+    if (!maybe_default_shape || maybe_default_shape->padded_head_count != kDefaultHeadCount ||
+        maybe_default_shape->head_tile_rows != ceil_div_u32(kDefaultHeadCount, TH)) {
+        return false;
+    }
+    if (derive_host_shape(TW, kCheckpointHeadCount) || derive_host_shape(kCheckpointHeadSize, 0) ||
+        derive_host_shape(kCheckpointHeadSize, kMaximumHeadCount + 1) ||
+        parse_positive_u32("") || parse_positive_u32("0") || parse_positive_u32("-1") ||
+        parse_positive_u32("+1") || parse_positive_u32("1x") || parse_positive_u32("4294967296")) {
+        return false;
+    }
+
+    const auto maybe_shape = derive_host_shape(kCheckpointHeadSize, kCheckpointHeadCount);
+    if (!maybe_shape) return false;
+    const HostShape shape = *maybe_shape;
+    const uint32_t expected_head_tile_rows = ceil_div_u32(kCheckpointHeadCount, TH);
+    const uint32_t expected_head_dimension_tiles = kCheckpointHeadSize / TW;
+    if (shape.head_tile_rows != expected_head_tile_rows ||
+        shape.tiles_per_head_dimension != expected_head_dimension_tiles ||
+        shape.channel_count != kCheckpointHeadSize * kCheckpointHeadCount) {
+        return false;
+    }
+
+    std::vector<float> input(static_cast<size_t>(shape.head_count) * shape.head_size);
+    for (uint32_t head = 0; head < shape.head_count; head++) {
+        for (uint32_t dimension = 0; dimension < shape.head_size; dimension++) {
+            input[static_cast<size_t>(head) * shape.head_size + dimension] =
+                static_cast<float>(head * shape.head_size + dimension + kFixtureValueOffset);
+        }
+    }
+    const auto tiled = build_native_input(input, shape, kShapeTestTokenCount, kShapeTestSequenceCount);
+    const size_t expected_tiled_elements =
+        static_cast<size_t>(shape.padded_head_count) * shape.head_size;
+    if (tiled.size() != expected_tiled_elements) return false;
+    const auto round_trip = untilize(tiled, shape.padded_head_count, shape.head_size);
+    if (round_trip.size() != expected_tiled_elements) return false;
+    for (uint32_t head = 0; head < shape.padded_head_count; head++) {
+        for (uint32_t dimension = 0; dimension < shape.head_size; dimension++) {
+            const size_t index = static_cast<size_t>(head) * shape.head_size + dimension;
+            const float expected = head < shape.head_count ? input[index] : 0.0f;
+            if (round_trip[index] != expected) return false;
+        }
+    }
+
+    std::vector<bool> writer_state_rows(static_cast<size_t>(shape.head_count) * shape.head_size, false);
+    for (uint32_t head = 0; head < shape.head_count; head++) {
+        for (uint32_t row = 0; row < shape.head_size; row++) {
+            const uint32_t source = head * shape.head_size + row;
+            const uint32_t destination = (source / shape.head_count) * shape.head_count +
+                                         source % shape.head_count;
+            if (destination != source || writer_state_rows[destination]) return false;
+            writer_state_rows[destination] = true;
+        }
+    }
+    if (std::find(writer_state_rows.begin(), writer_state_rows.end(), false) != writer_state_rows.end()) {
+        return false;
+    }
+
+    const uint32_t instance_count = kShapeTestSequenceCount * shape.head_count;
+    const uint32_t work_units = chunked_work_unit_count(instance_count);
+    const uint32_t odd_instance_count = instance_count + kShapeTestSequenceCount;
+    const uint32_t odd_work_units = chunked_work_unit_count(odd_instance_count);
+    const uint32_t odd_final_start = (odd_work_units - 1) * kChunkedGroupSize;
+    const uint32_t odd_final_end =
+        instance_end_for_units(odd_work_units - 1, kShapeTestSequenceCount,
+                               odd_instance_count, kChunkedGroupSize);
+    if (work_units * kChunkedGroupSize < instance_count ||
+        (work_units - 1) * kChunkedGroupSize >= instance_count ||
+        odd_work_units * kChunkedGroupSize < odd_instance_count ||
+        odd_final_start + kShapeTestSequenceCount != odd_instance_count ||
+        odd_final_end != odd_instance_count) {
+        return false;
+    }
+
+    std::printf("ttWKV7 checkpoint shape self-test: PASS S=%u H=%u Hpad=%u St=%u Ht=%u C=%u chunked_units=%u\n",
+                shape.head_size, shape.head_count, shape.padded_head_count,
+                shape.tiles_per_head_dimension, shape.head_tile_rows,
+                shape.channel_count, work_units);
+    return true;
+}
