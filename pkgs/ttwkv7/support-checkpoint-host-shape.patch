+constexpr uint32_t kDefaultHeadSize = 64;
+constexpr uint32_t kDefaultHeadCount = 32;
+constexpr uint32_t kCheckpointHeadSize = 64;
+constexpr uint32_t kCheckpointHeadCount = 12;
+constexpr uint32_t kChunkedGroupSize = 2;
+constexpr uint32_t kShapeTestSequenceCount = 1;
+constexpr uint32_t kShapeTestTokenCount = 1;
+constexpr uint32_t kMaximumHeadCount = 256;
+constexpr uint32_t kMaximumWorkloadCount = 256;
+constexpr uint32_t kFixtureValueOffset = 1;
+
+struct HostShape {
+    uint32_t head_size;
+    uint32_t head_count;
+    uint32_t padded_head_count;
+    uint32_t tiles_per_head_dimension;
+    uint32_t head_tile_rows;
+    uint32_t channel_count;
+};
+
+uint32_t ceil_div_u32(uint32_t value, uint32_t divisor) {
+    return value / divisor + static_cast<uint32_t>(value % divisor != 0);
+}
+
+std::optional<HostShape> derive_host_shape(uint32_t head_size, uint32_t head_count) {
+    if (head_size != kCheckpointHeadSize || head_count == 0 || head_count > kMaximumHeadCount) {
+        return std::nullopt;
+    }
+    if (head_count > std::numeric_limits<uint32_t>::max() / head_size) {
+        return std::nullopt;
+    }
+    const uint32_t head_tile_rows = ceil_div_u32(head_count, TH);
+    if (head_tile_rows > std::numeric_limits<uint32_t>::max() / TH) {
+        return std::nullopt;
+    }
+    return HostShape{
+        .head_size = head_size,
+        .head_count = head_count,
+        .padded_head_count = head_tile_rows * TH,
+        .tiles_per_head_dimension = head_size / TW,
+        .head_tile_rows = head_tile_rows,
+        .channel_count = head_size * head_count,
+    };
+}
+
+std::optional<uint32_t> parse_positive_u32(std::string_view text) {
+    if (text.empty()) return std::nullopt;
+    uint32_t value = 0;
+    const char* first = text.data();
+    const char* last = first + text.size();
+    const auto parsed = std::from_chars(first, last, value);
+    if (parsed.ec != std::errc{} || parsed.ptr != last || value == 0) return std::nullopt;
+    return value;
+}
+
+uint32_t chunked_work_unit_count(uint32_t instance_count) {
+    return ceil_div_u32(instance_count, kChunkedGroupSize);
+}
+
+uint32_t instance_end_for_units(uint32_t completed_units,
+                                uint32_t assigned_units,
+                                uint32_t instance_count,
+                                uint32_t instances_per_unit) {
+    const uint64_t unit_end =
+        (static_cast<uint64_t>(completed_units) + assigned_units) * instances_per_unit;
+    return static_cast<uint32_t>(std::min<uint64_t>(unit_end, instance_count));
+}
+
+bool workload_count_is_valid(uint32_t value) {
+    return value > 0 && value <= kMaximumWorkloadCount;
+}
