+                expected_ledger_blake3: digest.clone(),
+            },
+        };
+        let failure = serde_json::json!({ "result": "failure" });
+        verify_archived_host_receipt(repository, &evidence, adapter_id, &path, &digest, &failure)
+            .expect("exact failed historical Aspen receipt");
+        assert!(verify_archived_host_receipt(
+            repository, &evidence, "kiln-aspen-run-forged", &path, &digest, &failure,
+        ).is_err());
+        let mut wrong_revision = evidence.clone();
+        wrong_revision.revision = "forged-revision".to_string();
+        assert!(verify_archived_host_receipt(
+            repository, &wrong_revision, adapter_id, &path, &digest, &failure,
+        ).is_err());
+        assert!(verify_archived_host_receipt(
+            repository, &evidence, adapter_id, &path, &digest,
+            &serde_json::json!({ "result": "success" }),
+        ).is_err());
+        let sidecar = directory.path().join("archived-operations.sqlite-wal");
+        std::fs::write(&sidecar, b"unaccounted").expect("unaccounted archived host WAL");
+        assert!(verify_archived_host_receipt(
+            repository, &evidence, adapter_id, &path, &digest, &failure,
+        ).is_err());
+        std::fs::remove_file(&sidecar).expect("remove own isolated fixture WAL");
+        let mut false_success = record.clone();
+        let observation = false_success.provider_observation.as_mut()
+            .expect("archived provider observation");
+        observation.state = WorkflowState::Completed;
+        observation.successful = true;
+        observation.outcome = Outcome::Success;
+        assert!(false_success.validate().is_ok());
+        let forged_bytes = serde_json::to_vec(&false_success).expect("forged success receipt");
+        let ledger = rusqlite::Connection::open(&path).expect("reopen isolated archived ledger");
+        ledger.execute(
+            "UPDATE operations SET record_json = ?1, record_hash = ?2 WHERE operation_key = ?3",
+            rusqlite::params![
+                forged_bytes,
+                blake3::hash(&forged_bytes).to_hex().to_string(),
+                serde_json::to_string(&record.ingress.operation_id).expect("old operation key"),
+            ],
+        ).expect("forge locally consistent but false-success history");
+        drop(ledger);
+        let forged_digest = digest_file(&path).expect("forged ledger digest").to_hex().to_string();
+        assert!(verify_archived_host_receipt(
+            repository, &evidence, adapter_id, &path, &forged_digest, &failure,
+        ).is_err());
+    }
+}
