+            .map_err(|error| HostBridgeError::State(format!("read native retirement instance: {error:?}")))?;
+        if latest.as_ref() != Some(&self.latest_instance) {
+            return Err(HostBridgeError::State("native instance changed since journal snapshot verification".to_string()));
+        }
+        Ok(())
+    }
+}
+
+pub fn verify_journal_snapshot(plan: &RetirementPlan) -> Result<VerifiedNativeJournal> {
+    let path = plan.state_root.join("native-journal/fabric-durability.redb");
+    require_digest(&path, &plan.expected_native_journal_blake3)?;
+    let latest_instance = crate::recovery_preflight::native_log_snapshot(&path)?;
+    require_digest(&path, &plan.expected_native_journal_blake3)?;
+    Ok(VerifiedNativeJournal { latest_instance })
+}
+
+pub fn load_plan(path: &Path) -> Result<RetirementPlan> {
+    let mut bytes = Vec::new();
+    std::fs::File::open(path)
+        .map_err(|error| HostBridgeError::Io(format!("open retirement plan: {error}")))?
+        .take((MAXIMUM_PLAN_BYTES + 1) as u64)
+        .read_to_end(&mut bytes)
+        .map_err(|error| HostBridgeError::Io(format!("read retirement plan: {error}")))?;
+    if bytes.len() > MAXIMUM_PLAN_BYTES {
+        return Err(HostBridgeError::Admission("retirement plan exceeds its byte bound".to_string()));
+    }
+    let plan: RetirementPlan = serde_json::from_slice(&bytes)
+        .map_err(|error| HostBridgeError::Admission(format!("decode retirement plan: {error}")))?;
+    for path in [
+        &plan.aspen_profile, &plan.extension, &plan.state_root, &plan.host_socket,
+        &plan.lattice_socket, &plan.broker_database, &plan.lattice_database,
+        &plan.report_namespace, &plan.preserved_report_root,
+    ] {
+        if !path.is_absolute() || path.components().any(|component| {
+            matches!(component, std::path::Component::ParentDir | std::path::Component::CurDir)
+        }) {
+            return Err(HostBridgeError::Admission("retirement paths must be absolute without dot components".to_string()));
+        }
+    }
+    if plan.repaired_lattice.as_ref().is_some_and(|evidence| {
+        !valid_plan_path(&evidence.stopped_backup_database)
+            || !valid_plan_path(&evidence.repaired_clone_database)
+            || !is_blake3_hex(&evidence.expected_repaired_clone_blake3)
+    }) {
+        return Err(HostBridgeError::Admission("repaired Lattice evidence path or digest is invalid".to_string()));
+    }
+    if plan.repository.is_empty()
+        || plan.approved_unlinked_reports.len() > MAXIMUM_REPORT_FILES
+        || plan.approved_unlinked_reports.iter().any(|evidence| {
+            if evidence.revision.is_empty()
+                || evidence.broker_run_id.is_empty()
+                || evidence.broker_job_id.is_empty()
+            {
+                return true;
+            }
+            match &evidence.origin {
+                HistoricalReportOrigin::Legacy { report, log, report_blake3, log_blake3 } => {
+                    [report, log].iter().any(|path| !valid_plan_path(path))
+                        || !is_blake3_hex(report_blake3)
+                        || !is_blake3_hex(log_blake3)
+                }
+                HistoricalReportOrigin::Aspen { operation_ledger, expected_ledger_blake3 } => {
+                    !valid_plan_path(operation_ledger) || !is_blake3_hex(expected_ledger_blake3)
+                }
+            }
+        })
+        || [
+            &plan.expected_native_journal_blake3,
+            &plan.expected_host_ledger_blake3,
+            &plan.expected_broker_blake3,
+            &plan.expected_lattice_blake3,
+            &plan.expected_preserved_report_root_blake3,
+        ].into_iter().chain(
+            plan.approved_unlinked_reports.iter()
+                .flat_map(|evidence| [&evidence.report_blake3, &evidence.log_blake3])
+        ).any(|hash| !is_blake3_hex(hash))
+    {
+        return Err(HostBridgeError::Admission("retirement plan identity or digest is invalid".to_string()));
+    }
+    Ok(plan)
+}
+
+fn valid_plan_path(path: &Path) -> bool {
+    path.is_absolute() && !path.components().any(|component| {
+        matches!(component, std::path::Component::ParentDir | std::path::Component::CurDir)
+    })
+}
+
+pub fn retire(plan: &RetirementPlan, profile: AdmittedAspenRuntimeProfile, runtime_profile: PathBuf) -> Result<()> {
+    let (cohort, external, native_snapshot) = prepare_retirement(plan, profile, runtime_profile)?;
+    retire_native(cohort, external, &native_snapshot)
+}
+
+pub fn audit_offline_copy(plan: &RetirementPlan, profile: AdmittedAspenRuntimeProfile, _runtime_profile: PathBuf) -> Result<()> {
+    require_services_stopped(&plan.host_socket)?;
+    require_socket_absent(&plan.host_socket)?;
+    require_socket_absent(&plan.lattice_socket)?;
+    let snapshot = verify_journal_snapshot(plan)?;
+    require_retirability(&snapshot.latest_instance)?;
+    let records = crate::durability::HostDurability::inspect_operations_read_only(&plan.state_root, &profile)?;
+    require_terminal_records(&records)?;
+    let external = verify_external(plan, &records)?;
+    require_services_stopped(&plan.host_socket)?;
+    require_socket_absent(&plan.host_socket)?;
+    require_socket_absent(&plan.lattice_socket)?;
+    let final_snapshot = verify_journal_snapshot(plan)?;
+    if final_snapshot.latest_instance != snapshot.latest_instance {
+        return Err(HostBridgeError::State("native instance changed during read-only retirement audit".to_string()));
+    }
+    println!("offline retirement evidence audited without opening the native cohort: host_operations={}, lattice_exchanges={}, published_reports={}", records.len(), external.exchange_revisions.len(), external.report_revisions.len());
+    Ok(())
+}
+
+fn prepare_retirement(
+    plan: &RetirementPlan, profile: AdmittedAspenRuntimeProfile, runtime_profile: PathBuf,
+) -> Result<(HostCohort, VerifiedExternalState, VerifiedNativeJournal)> {
+    require_services_stopped(&plan.host_socket)?;
+    require_socket_absent(&plan.host_socket)?;
+    require_socket_absent(&plan.lattice_socket)?;
+    require_broker_exclusive(&plan.broker_database)?;
+    let native_snapshot = verify_journal_snapshot(plan)?;
+    require_retirability(&native_snapshot.latest_instance)?;
+    require_digest(&plan.state_root.join("operation-ledger/operations.sqlite"), &plan.expected_host_ledger_blake3)?;
+    require_digest(&plan.broker_database, &plan.expected_broker_blake3)?;
+    require_digest(&plan.lattice_database, &plan.expected_lattice_blake3)?;
+    let cohort = HostCohort::build(
+        profile,
+        &HostPaths {
+            extension_executable: plan.extension.clone(),
+            runtime_profile,
+            workspace: plan.state_root.clone(),
+        },
+    )?;
+    let records = require_terminal_host_operations(&cohort)?;
+    let external = verify_external(plan, &records)?;
+    require_services_stopped(&plan.host_socket)?;
+    require_socket_absent(&plan.host_socket)?;
+    require_socket_absent(&plan.lattice_socket)?;
+    native_snapshot.require_same_instance(&cohort)?;
+    require_broker_exclusive(&plan.broker_database)?;
+    require_digest(&plan.broker_database, &plan.expected_broker_blake3)?;
+    require_digest(&plan.lattice_database, &plan.expected_lattice_blake3)?;
+    require_digest(&plan.state_root.join("operation-ledger/operations.sqlite"), &plan.expected_host_ledger_blake3)?;
+    Ok((cohort, external, native_snapshot))
+}
+
+fn require_services_stopped(host_socket: &Path) -> Result<()> {
+    for unit in [BROKER_UNIT, HOST_UNIT, LATTICE_UNIT] {
+        let result = Command::new("systemctl")
+            .args([
+                "show", unit, "--property=LoadState", "--property=ActiveState",
+                "--property=SubState", "--property=MainPID", "--property=ControlPID",
+                "--property=ControlGroup",
+            ])
+            .output()
+            .map_err(|error| HostBridgeError::State(format!("inspect {unit}: {error}")))?;
+        let output = std::str::from_utf8(&result.stdout)
+            .map_err(|_| HostBridgeError::State(format!("decode {unit} status")))?;
+        if !result.status.success() || !stopped_unit_status(output, unit == HOST_UNIT) {
+            return Err(HostBridgeError::State(format!("operator retirement requires stopped {unit}")));
+        }
+        if unit == HOST_UNIT && output.lines().any(|line| line == "ActiveState=failed") {
+            require_socket_absent(host_socket)?;
+        }
+    }
+    Ok(())
+}
+
+fn stopped_unit_status(output: &str, allow_failed_host: bool) -> bool {
+    let present = |required: &str| output.lines().any(|line| line == required);
+    present("LoadState=loaded")
+        && present("MainPID=0")
+        && present("ControlPID=0")
+        && present("ControlGroup=")
+        && ((present("ActiveState=inactive") && present("SubState=dead"))
+            || (allow_failed_host && present("ActiveState=failed") && present("SubState=failed")))
+}
+
+fn require_socket_absent(path: &Path) -> Result<()> {
+    match std::fs::symlink_metadata(path) {
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),
+        Ok(_) => Err(HostBridgeError::State(format!("operator retirement requires absent socket: {}", path.display()))),
+        Err(error) => Err(HostBridgeError::Io(format!("inspect retirement socket {}: {error}", path.display()))),
+    }
+}
+
+fn open_regular(path: &Path) -> Result<std::fs::File> {
+    let descriptor = rustix::fs::open(
+        path,
+        rustix::fs::OFlags::RDONLY | rustix::fs::OFlags::NOFOLLOW | rustix::fs::OFlags::CLOEXEC,
+        rustix::fs::Mode::empty(),
+    )
+    .map_err(|error| HostBridgeError::Io(format!("open retirement evidence {}: {error}", path.display())))?;
+    let file = std::fs::File::from(descriptor);
+    if !file.metadata().map_err(|error| HostBridgeError::Io(format!("stat retirement evidence: {error}")))?.is_file() {
+        return Err(HostBridgeError::State(format!("retirement evidence is not a regular file: {}", path.display())));
+    }
+    Ok(file)
+}
+
+fn digest_file(path: &Path) -> Result<blake3::Hash> {
+    let mut file = open_regular(path)?;
+    let mut hasher = blake3::Hasher::new();
+    let mut buffer = [0u8; DIGEST_BUFFER_BYTES];
+    loop {
+        let read = file.read(&mut buffer)
+            .map_err(|error| HostBridgeError::Io(format!("hash retirement evidence {}: {error}", path.display())))?;
+        if read == 0 {
+            break;
+        }
+        hasher.update(&buffer[..read]);
+    }
+    Ok(hasher.finalize())
+}
+
+fn require_digest(path: &Path, expected: &str) -> Result<()> {
+    if digest_file(path)?.to_hex().as_str() != expected {
+        return Err(HostBridgeError::State(format!("retirement evidence digest changed: {}", path.display())));
+    }
+    Ok(())
+}
+
+fn is_blake3_hex(value: &str) -> bool {
+    value.len() == 64 && value.bytes().all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase())
+}
+
+fn require_broker_exclusive(path: &Path) -> Result<()> {
+    for suffix in ["-wal", "-shm", "-journal"] {
+        let mut sidecar = path.as_os_str().to_owned();
+        sidecar.push(suffix);
+        match std::fs::symlink_metadata(Path::new(&sidecar)) {
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Ok(_) => return Err(HostBridgeError::State(
+                "broker SQLite sidecar exists; main database hash does not cover pending evidence".to_string(),
+            )),
+            Err(error) => return Err(HostBridgeError::Io(format!("inspect broker SQLite sidecar: {error}"))),
+        }
+    }
+    Ok(())
+}
+
+pub fn require_terminal_host_operations(cohort: &HostCohort) -> Result<Vec<DurableOperationRecord>> {
+    if cohort.state_mode != HostStateMode::Recovered {
+        return Err(HostBridgeError::State("retirement requires an existing native cohort".to_string()));
+    }
+    let records = cohort.ledger.lock()
+        .map_err(|_| HostBridgeError::State("retirement ledger lock unavailable".to_string()))?
+        .load_all()?;
+    require_terminal_records(&records)?;
+    Ok(records)
+}
+
+fn require_terminal_records(records: &[DurableOperationRecord]) -> Result<()> {
+    for record in records {
+        if record.state != DurableOperationState::Terminal
+            || record.acknowledgement.is_none()
+            || record.effect_intent.is_none()
+            || record.provider_observation.is_none()
+        {
+            return Err(HostBridgeError::State("retirement requires terminal acknowledged, observed host operations".to_string()));
+        }
+    }
+    Ok(())
+}
+
+fn require_lattice_evidence(plan: &RetirementPlan) -> Result<()> {
+    require_digest(&plan.lattice_database, &plan.expected_lattice_blake3)?;
+    if let Some(evidence) = &plan.repaired_lattice {
+        require_digest(&evidence.stopped_backup_database, &plan.expected_lattice_blake3)?;
+        require_digest(&evidence.repaired_clone_database, &evidence.expected_repaired_clone_blake3)?;
+        if plan.expected_lattice_blake3 == evidence.expected_repaired_clone_blake3 {
+            return Err(HostBridgeError::State("repaired Lattice clone is identical to the stopped source".to_string()));
+        }
+        use std::os::unix::fs::MetadataExt;
+        let source = std::fs::metadata(&plan.lattice_database)
+            .map_err(|error| HostBridgeError::Io(format!("inspect original Lattice inode: {error}")))?;
+        let backup = std::fs::metadata(&evidence.stopped_backup_database)
+            .map_err(|error| HostBridgeError::Io(format!("inspect preserved Lattice inode: {error}")))?;
+        let clone = std::fs::metadata(&evidence.repaired_clone_database)
+            .map_err(|error| HostBridgeError::Io(format!("inspect repaired Lattice inode: {error}")))?;
+        if source.dev() == backup.dev() && source.ino() == backup.ino()
+            || source.dev() == clone.dev() && source.ino() == clone.ino()
+            || backup.dev() == clone.dev() && backup.ino() == clone.ino()
+        {
+            return Err(HostBridgeError::State("stopped, preserved, and repaired Lattice files must have distinct inodes".to_string()));
+        }
+    }
+    Ok(())
+}
+
+pub fn verify_external(plan: &RetirementPlan, records: &[DurableOperationRecord]) -> Result<VerifiedExternalState> {
+    require_digest(&plan.state_root.join("operation-ledger/operations.sqlite"), &plan.expected_host_ledger_blake3)?;
+    require_lattice_evidence(plan)?;
+    require_broker_exclusive(&plan.broker_database)?;
+    let broker = rusqlite::Connection::open_with_flags(
+        &plan.broker_database,
+        OpenFlags::SQLITE_OPEN_READ_ONLY | OpenFlags::SQLITE_OPEN_NO_MUTEX,
+    ).map_err(|error| HostBridgeError::State(format!("open broker database read-only: {error}")))?;
+    let queued: i64 = broker.query_row("SELECT COUNT(*) FROM ci_event_queue", [], |row| row.get(0))
+        .map_err(|error| HostBridgeError::State(format!("read broker queue: {error}")))?;
+    if queued != 0 {
+        return Err(HostBridgeError::State("operator retirement refuses broker queue or lease".to_string()));
+    }
+    let mut broker_runs = BTreeMap::new();
+    let mut runs = broker.prepare("SELECT broker_run_id, json FROM ci_runs")
+        .map_err(|error| HostBridgeError::State(format!("read broker run inventory: {error}")))?;
+    let rows = runs.query_map([], |row| Ok((row.get::<_, String>(0)?, row.get::<_, String>(1)?)))
+        .map_err(|error| HostBridgeError::State(format!("scan broker run inventory: {error}")))?;
+    for row in rows {
+        let (run_id, json) = row.map_err(|error| HostBridgeError::State(format!("broker run: {error}")))?;
+        let value: Value = serde_json::from_str(&json)
+            .map_err(|error| HostBridgeError::State(format!("broker run JSON: {error}")))?;
+        if value["state"].as_str() != Some("finished") {
+            return Err(HostBridgeError::State("operator retirement refuses active broker run or lease".to_string()));
+        }
+        if value["broker_run_id"]["id"].as_str() != Some(run_id.as_str())
+            || broker_runs.insert(run_id, value).is_some()
+        {
+            return Err(HostBridgeError::State("broker run identity is ambiguous".to_string()));
+        }
+    }
+    require_broker_exclusive(&plan.broker_database)?;
+
+    let lattice = match lattice_redb::Database::builder().open_read_only(&plan.lattice_database) {
+        Ok(lattice) if plan.repaired_lattice.is_none() => lattice,
+        Ok(_) => return Err(HostBridgeError::State("repaired Lattice clone is supplied but the original opens without repair".to_string())),
+        Err(lattice_redb::DatabaseError::RepairAborted) => {
+            let evidence = plan.repaired_lattice.as_ref()
+                .ok_or_else(|| HostBridgeError::State("stopped Lattice database needs a separately audited repaired clone; original remains read-only".to_string()))?;
+            require_lattice_evidence(plan)?;
+            lattice_redb::Database::builder()
+                .open_read_only(&evidence.repaired_clone_database)
+                .map_err(|error| HostBridgeError::State(format!("open verified repaired Lattice clone read-only: {error}")))?
+        }
+        Err(error) => return Err(HostBridgeError::State(format!("open original Lattice exchange read-only: {error}"))),
+    };
+    let transaction = lattice.begin_read()
+        .map_err(|error| HostBridgeError::State(format!("read Lattice exchange: {error}")))?;
+    let exchanges = transaction.open_table(LATTICE_EXCHANGES)
+        .map_err(|error| HostBridgeError::State(format!("read Lattice executions: {error}")))?;
+    let requests = transaction.open_table(LATTICE_REQUESTS)
+        .map_err(|error| HostBridgeError::State(format!("read Lattice request index: {error}")))?;
+    let idempotency = transaction.open_table(LATTICE_IDEMPOTENCY)
+        .map_err(|error| HostBridgeError::State(format!("read Lattice idempotency index: {error}")))?;
+    if exchanges.len().map_err(|error| HostBridgeError::State(format!("count Lattice executions: {error}")))?
+        != requests.len().map_err(|error| HostBridgeError::State(format!("count Lattice requests: {error}")))?
+        || exchanges.len().map_err(|error| HostBridgeError::State(format!("count Lattice executions: {error}")))?
+            != idempotency.len().map_err(|error| HostBridgeError::State(format!("count Lattice idempotency: {error}")))?
+    {
+        return Err(HostBridgeError::State("Lattice exchange indexes are incomplete".to_string()));
+    }
+    let mut exchange_revisions = BTreeMap::new();
+    for item in exchanges.iter().map_err(|error| HostBridgeError::State(format!("scan Lattice exchanges: {error}")))? {
+        let (identity, bytes) = item.map_err(|error| HostBridgeError::State(format!("Lattice exchange record: {error}")))?;
+        let item: Value = serde_json::from_slice(bytes.value())
+            .map_err(|error| HostBridgeError::State(format!("Lattice exchange JSON: {error}")))?;
+        if !matches!(item["state"].as_str(), Some("completed" | "failed" | "cancelled"))
+            || item["receipt_identity"].as_str().is_none()
+        {
+            return Err(HostBridgeError::State("operator retirement refuses unresolved Lattice exchange or lease".to_string()));
+        }
+        let revision = item["request"]["source"]["revision"].as_str()
+            .ok_or_else(|| HostBridgeError::State("Lattice exchange lacks source revision".to_string()))?;
+        let request_identity = item["request"]["identity"].as_str()
+            .ok_or_else(|| HostBridgeError::State("Lattice exchange lacks request identity".to_string()))?;
+        let idempotency_identity = item["request"]["idempotency_key"].as_str()
+            .ok_or_else(|| HostBridgeError::State("Lattice exchange lacks idempotency identity".to_string()))?;
+        for index_identity in [
+            requests.get(request_identity).map_err(|error| HostBridgeError::State(format!("Lattice request index: {error}")))?,
+            idempotency.get(idempotency_identity).map_err(|error| HostBridgeError::State(format!("Lattice idempotency index: {error}")))?,
+        ] {
+            if index_identity.as_ref().map(|indexed| indexed.value()) != Some(identity.value()) {
+                return Err(HostBridgeError::State("Lattice exchange index identity mismatch".to_string()));
+            }
+        }
+        exchange_revisions.insert(identity.value().to_string(), revision.to_string());
+    }
+    if exchange_revisions.len() != records.len() {
+        return Err(HostBridgeError::State("host operation count differs from terminal Lattice exchange count".to_string()));
+    }
+    let mut host_revisions = BTreeSet::new();
+    for record in records {
+        let revision = record.ingress.trigger.after.native_id.as_str();
+        let repository = record.ingress.trigger.repository.native_id.as_str();
+        if repository != plan.repository || !host_revisions.insert(revision.to_string()) {
+            return Err(HostBridgeError::State("host operation repository or revision is ambiguous".to_string()));
+        }
+        let execution = record.provider_observation.as_ref()
+            .ok_or_else(|| HostBridgeError::State("host operation lacks provider observation".to_string()))?
+            .execution.native_id.as_str();
+        if exchange_revisions.get(execution).map(String::as_str) != Some(revision) {
+            return Err(HostBridgeError::State("terminal host operation does not match Lattice exchange revision".to_string()));
+        }
+    }
+    let report_revisions = verify_reports(plan, &host_revisions, &broker_runs)?;
+    require_digest(&plan.state_root.join("operation-ledger/operations.sqlite"), &plan.expected_host_ledger_blake3)?;
+    require_lattice_evidence(plan)?;
+    Ok(VerifiedExternalState { exchange_revisions, report_revisions })
+}
+
+fn directory_digest(root: &Path) -> Result<blake3::Hash> {
+    if !std::fs::symlink_metadata(root)
+        .map_err(|error| HostBridgeError::Io(format!("inspect preserved report root: {error}")))?
+        .is_dir()
+    {
+        return Err(HostBridgeError::State("preserved report root is not a directory".to_string()));
+    }
+    let mut files = BTreeMap::new();
+    for entry in std::fs::read_dir(root)
+        .map_err(|error| HostBridgeError::Io(format!("read preserved report root: {error}")))?
+    {
+        let entry = entry.map_err(|error| HostBridgeError::Io(format!("preserved report entry: {error}")))?;
+        let name = entry.file_name().into_string()
+            .map_err(|_| HostBridgeError::State("preserved report name is not UTF-8".to_string()))?;
+        if files.insert(name, entry.path()).is_some() || files.len() > MAXIMUM_REPORT_FILES {
+            return Err(HostBridgeError::State("preserved report inventory is ambiguous or unbounded".to_string()));
+        }
+    }
+    let mut hasher = blake3::Hasher::new();
+    for (name, path) in files {
+        let digest = digest_file(&path)?;
+        hasher.update(&(name.len() as u64).to_be_bytes());
+        hasher.update(name.as_bytes());
+        hasher.update(digest.to_hex().as_bytes());
+    }
+    Ok(hasher.finalize())
+}
+
+fn read_report(path: &Path) -> Result<Vec<u8>> {
+    let mut bytes = Vec::new();
+    open_regular(path)?
+        .take((MAXIMUM_REPORT_JSON_BYTES + 1) as u64)
+        .read_to_end(&mut bytes)
+        .map_err(|error| HostBridgeError::Io(format!("read published report: {error}")))?;
+    if bytes.len() > MAXIMUM_REPORT_JSON_BYTES {
+        return Err(HostBridgeError::State("published report exceeds its byte bound".to_string()));
+    }
+    Ok(bytes)
+}
+
+fn verify_reports(
+    plan: &RetirementPlan,
+    host_revisions: &BTreeSet<String>,
+    broker_runs: &BTreeMap<String, Value>,
+) -> Result<BTreeSet<String>> {
+    let mut report_revisions = BTreeSet::new();
+    let mut report_evidence = BTreeMap::<String, (String, blake3::Hash, blake3::Hash, bool)>::new();
+    let mut log_names = BTreeSet::new();
+    let mut report_names = BTreeSet::new();
+    if !std::fs::symlink_metadata(&plan.report_namespace)
+        .map_err(|error| HostBridgeError::Io(format!("inspect published report root: {error}")))?
+        .is_dir()
+    {
+        return Err(HostBridgeError::State("published report root is not a directory".to_string()));
+    }
+    let entries = std::fs::read_dir(&plan.report_namespace)
+        .map_err(|error| HostBridgeError::Io(format!("open report namespace: {error}")))?;
+    for entry in entries {
+        let entry = entry.map_err(|error| HostBridgeError::Io(format!("report entry: {error}")))?;
+        let name = entry.file_name().into_string()
+            .map_err(|_| HostBridgeError::State("report name is not UTF-8".to_string()))?;
+        if report_names.len() + log_names.len() >= MAXIMUM_REPORT_FILES {
+            return Err(HostBridgeError::State("report inventory exceeds its bound".to_string()));
+        }
+        if !entry.file_type().map_err(|error| HostBridgeError::Io(format!("report file type: {error}")))?.is_file() {
+            return Err(HostBridgeError::State("report inventory contains a non-file".to_string()));
+        }
+        if let Some(stem) = name.strip_suffix(".json") {
+            report_names.insert(stem.to_string());
+            let report_bytes = read_report(&entry.path())?;
+            let report_digest = blake3::hash(&report_bytes);
+            let value: Value = serde_json::from_slice(&report_bytes)
+                .map_err(|error| HostBridgeError::State(format!("decode report: {error}")))?;
+            if value["run_identity"].as_str().and_then(|id| id.strip_prefix("b3:")) != Some(stem)
+                || value["repository"].as_str() != Some(&plan.repository)
+                || !matches!(value["outcome"].as_str(), Some("success" | "failure"))
+            {
+                return Err(HostBridgeError::State("published report identity or outcome is invalid".to_string()));
+            }
+            let revision = value["revision"].as_str()
+                .ok_or_else(|| HostBridgeError::State("published report lacks revision".to_string()))?;
+            if !report_revisions.insert(revision.to_string()) {
+                return Err(HostBridgeError::State("multiple reports name one revision".to_string()));
+            }
+            let log_digest = digest_file(&plan.report_namespace.join(format!("{stem}.log")))?;
+            if value["log_blake3"].as_str() != Some(log_digest.to_hex().as_str()) {
+                return Err(HostBridgeError::State("published report log digest differs".to_string()));
+            }
+            report_evidence.insert(revision.to_string(), (
+                stem.to_string(), report_digest, log_digest, value["outcome"] == "success",
+            ));
+        } else if let Some(stem) = name.strip_suffix(".log") {
+            log_names.insert(stem.to_string());
+        } else {
+            return Err(HostBridgeError::State("report namespace contains an unrecognized artifact".to_string()));
+        }
+    }
+    if report_names != log_names || !host_revisions.is_subset(&report_revisions) {
+        return Err(HostBridgeError::State("published reports do not cover all terminal host operations".to_string()));
+    }
+    if std::fs::canonicalize(&plan.report_namespace)
+        .map_err(|error| HostBridgeError::Io(format!("resolve published report root: {error}")))?
+        == std::fs::canonicalize(&plan.preserved_report_root)
+            .map_err(|error| HostBridgeError::Io(format!("resolve preserved report root: {error}")))?
+        || directory_digest(&plan.preserved_report_root)?.to_hex().as_str()
+            != plan.expected_preserved_report_root_blake3
+    {
+        return Err(HostBridgeError::State("preserved report root is not a separate verified backup".to_string()));
+    }
+    let approved: BTreeSet<_> = plan.approved_unlinked_reports.iter().map(|item| item.revision.clone()).collect();
+    if approved.len() != plan.approved_unlinked_reports.len()
+        || report_revisions.difference(host_revisions).cloned().collect::<BTreeSet<_>>() != approved
+    {
+        return Err(HostBridgeError::State("unlinked published reports lack archived evidence".to_string()));
+    }
+    for evidence in &plan.approved_unlinked_reports {
+        let Some((stem, report_digest, log_digest, succeeded)) = report_evidence.get(&evidence.revision) else {
+            return Err(HostBridgeError::State("approved report revision is absent".to_string()));
+        };
+        let Some(run) = broker_runs.get(&evidence.broker_run_id) else {
+            return Err(HostBridgeError::State("approved historical broker run is absent".to_string()));
+        };
+        if run["whence"]["Branch"]["commit"].as_str() != Some(evidence.revision.as_str())
+            || run["job_id"].as_str() != Some(evidence.broker_job_id.as_str())
+            || run["repo_id"].as_str() != Some(plan.repository.as_str())
+            || run["result"].as_str() != Some(if *succeeded { "success" } else { "failure" })
+            || run["adapter_run_id"]["id"].as_str().is_none_or(str::is_empty)
+        {
+            return Err(HostBridgeError::State("historical broker run does not corroborate published revision and outcome".to_string()));
+        }
+        verify_historical_origin(plan, evidence, run)?;
+        if report_digest.to_hex().as_str() != evidence.report_blake3
+            || log_digest.to_hex().as_str() != evidence.log_blake3
+            || digest_file(&plan.preserved_report_root.join(format!("{stem}.json")))?.to_hex().as_str()
+                != evidence.report_blake3
+            || digest_file(&plan.preserved_report_root.join(format!("{stem}.log")))?.to_hex().as_str()
+                != evidence.log_blake3
+        {
+            return Err(HostBridgeError::State("archived unlinked report evidence differs from published bytes".to_string()));
+        }
+    }
+    Ok(report_revisions)
+}
+
+fn verify_historical_origin(plan: &RetirementPlan, evidence: &ArchivedReportEvidence, run: &Value) -> Result<()> {
+    let adapter_id = run["adapter_run_id"]["id"].as_str()
+        .ok_or_else(|| HostBridgeError::State("historical broker adapter run is absent".to_string()))?;
+    match &evidence.origin {
+        HistoricalReportOrigin::Legacy { report, log, report_blake3, log_blake3 } => {
+            let Some(rid) = plan.repository.strip_prefix("rad:") else {
+                return Err(HostBridgeError::State("historical legacy repository lacks Radicle RID".to_string()));
+            };
+            if !adapter_id.starts_with("kiln-")
+                || adapter_id.starts_with("kiln-aspen-")
+                || !adapter_id.bytes().all(|byte| byte.is_ascii_alphanumeric() || byte == b'-')
+                || report.file_name().and_then(|name| name.to_str()) != Some(format!("{adapter_id}.json").as_str())
+                || log.file_name().and_then(|name| name.to_str()) != Some(format!("{adapter_id}.log").as_str())
+                || report.parent() != log.parent()
+                || run["adapter_info_url"].as_str()
+                    != Some(format!("https://ci.onix.computer/reports/{rid}/{adapter_id}.log").as_str())
+            {
+                return Err(HostBridgeError::State("historical legacy broker URL or artifact lineage is inconsistent".to_string()));
+            }
+            let bytes = read_report(report)?;
+            let legacy: Value = serde_json::from_slice(&bytes)
+                .map_err(|error| HostBridgeError::State(format!("decode historical legacy report: {error}")))?;
+            if legacy["schema"].as_str() != Some("onix.radicle-ci-report.v1")
+                || legacy["run_id"].as_str() != Some(adapter_id)
+                || legacy["repository"].as_str() != Some(plan.repository.as_str())
+                || legacy["revision"].as_str() != Some(evidence.revision.as_str())
+                || legacy["result"].as_str() != run["result"].as_str()
+                || blake3::hash(&bytes).to_hex().as_str() != report_blake3
+                || digest_file(log)?.to_hex().as_str() != log_blake3
+            {
+                return Err(HostBridgeError::State("historical legacy report and log do not corroborate the terminal broker run".to_string()));
+            }
+        }
+        HistoricalReportOrigin::Aspen { operation_ledger, expected_ledger_blake3 } => {
+            if !adapter_id.starts_with("kiln-aspen-run-") {
+                return Err(HostBridgeError::State("historical Aspen origin names a non-Aspen broker run".to_string()));
+            }
+            verify_archived_host_receipt(&plan.repository, evidence, adapter_id, operation_ledger, expected_ledger_blake3, run)?;
+        }
+    }
+    Ok(())
+}
+
+fn verify_archived_host_receipt(
+    repository: &str,
+    evidence: &ArchivedReportEvidence,
+    adapter_id: &str,
+    path: &Path,
+    expected_digest: &str,
+    broker_run: &Value,
+) -> Result<()> {
+    for suffix in ["-wal", "-shm", "-journal"] {
+        let mut sidecar = path.as_os_str().to_os_string();
+        sidecar.push(suffix);
+        match std::fs::symlink_metadata(&sidecar) {
+            Err(error) if error.kind() == std::io::ErrorKind::NotFound => {}
+            Ok(_) => return Err(HostBridgeError::State("historical host ledger has unaccounted SQLite sidecar".to_string())),
+            Err(error) => return Err(HostBridgeError::Io(format!("inspect historical host ledger sidecar: {error}"))),
+        }
+    }
+    require_digest(path, expected_digest)?;
+    let ledger = rusqlite::Connection::open_with_flags(
+        path, OpenFlags::SQLITE_OPEN_READ_ONLY | OpenFlags::SQLITE_OPEN_NO_MUTEX,
+    ).map_err(|error| HostBridgeError::State(format!("open historical host ledger read-only: {error}")))?;
+    let integrity: String = ledger.query_row("PRAGMA quick_check", [], |row| row.get(0))
+        .map_err(|error| HostBridgeError::State(format!("check historical host ledger: {error}")))?;
+    let schema: String = ledger.query_row("SELECT value FROM metadata WHERE key = 'schema'", [], |row| row.get(0))
+        .map_err(|error| HostBridgeError::State(format!("read historical host ledger schema: {error}")))?;
+    if integrity != "ok" || schema != "kiln.aspen-host.operation-ledger.v1" {
+        return Err(HostBridgeError::State("historical host ledger integrity or schema differs".to_string()));
+    }
+    let mut statement = ledger.prepare(
+        "SELECT operation_key, record_json, record_hash FROM operations ORDER BY operation_key LIMIT 257",
+    ).map_err(|error| HostBridgeError::State(format!("scan historical host ledger: {error}")))?;
+    let rows = statement.query_map([], |row| {
+        Ok((row.get::<_, String>(0)?, row.get::<_, Vec<u8>>(1)?, row.get::<_, String>(2)?))
+    }).map_err(|error| HostBridgeError::State(format!("read historical host ledger: {error}")))?;
+    let mut seen = 0;
+    let mut matched = false;
+    for row in rows {
+        seen += 1;
+        if seen > MAXIMUM_REPORT_FILES {
+            return Err(HostBridgeError::State("historical host ledger exceeds its record bound".to_string()));
+        }
+        let (key, bytes, digest) = row
+            .map_err(|error| HostBridgeError::State(format!("decode historical host record row: {error}")))?;
+        if bytes.len() > MAXIMUM_REPORT_JSON_BYTES || blake3::hash(&bytes).to_hex().as_str() != digest {
+            return Err(HostBridgeError::State("historical host receipt record is oversized or changed".to_string()));
+        }
+        let record: DurableOperationRecord = serde_json::from_slice(&bytes)
+            .map_err(|error| HostBridgeError::State(format!("decode historical host receipt: {error}")))?;
+        record.validate().map_err(HostBridgeError::State)?;
+        if serde_json::to_string(&record.ingress.operation_id).ok().as_deref() != Some(key.as_str()) {
+            return Err(HostBridgeError::State("historical host receipt key differs from its operation".to_string()));
+        }
+        let (Some(ack), Some(observation)) = (
+            record.acknowledgement.as_ref(), record.provider_observation.as_ref(),
+        ) else {
+            return Err(HostBridgeError::State("historical host ledger contains an unobserved or unacknowledged operation".to_string()));
+        };
+        let truthful_result = match ack.decision {
+            kiln_adapter_aspen::transport::AspenServiceDecision::Completed => {
+                observation.successful && observation.outcome == kiln_core::domain::Outcome::Success
+            }
+            kiln_adapter_aspen::transport::AspenServiceDecision::Failed => {
+                !observation.successful && observation.outcome.is_terminal()
+                    && observation.outcome != kiln_core::domain::Outcome::Success
+            }
+            _ => false,
+        };
+        if record.state != DurableOperationState::Terminal || record.effect_intent.is_none()
+            || !observation.state.is_terminal() || !truthful_result
+        {
+            return Err(HostBridgeError::State("historical host ledger has nonterminal or false-success receipt".to_string()));
+        }
+        if ack.run_id.as_ref().is_some_and(|id| id.as_str() == adapter_id) {
+            let result_matches = match broker_run["result"].as_str() {
+                Some("success") => ack.decision == kiln_adapter_aspen::transport::AspenServiceDecision::Completed,
+                Some("failure") => ack.decision == kiln_adapter_aspen::transport::AspenServiceDecision::Failed,
+                _ => false,
+            };
+            if matched || !result_matches
+                || record.ingress.trigger.repository.native_id.as_str() != repository
+                || record.ingress.trigger.after.native_id.as_str() != evidence.revision
+            {
+                return Err(HostBridgeError::State("historical Aspen broker run conflicts with archived terminal host receipt".to_string()));
+            }
+            matched = true;
+        }
+    }
+    if !matched {
+        return Err(HostBridgeError::State("historical Aspen broker run lacks matching archived host receipt".to_string()));
+    }
+    drop(statement);
+    drop(ledger);
+    require_digest(path, expected_digest)
+}
+
+pub fn retire_native(cohort: HostCohort, verified: VerifiedExternalState, native_snapshot: &VerifiedNativeJournal) -> Result<()> {
+    let operations = require_terminal_host_operations(&cohort)?;
+    if operations.len() != verified.exchange_revisions.len()
+        || verified.report_revisions.len() < operations.len()
+    {
+        return Err(HostBridgeError::State("retirement inventory changed before native transition".to_string()));
+    }
+    native_snapshot.require_same_instance(&cohort)?;
+    let mut service = cohort.open_service()?;
+    let instance = service.instance()
+        .map_err(|error| HostBridgeError::State(format!("native retirement instance: {error:?}")))?;
+    if instance != native_snapshot.latest_instance {
+        return Err(HostBridgeError::State("recovered native instance differs from journal snapshot".to_string()));
+    }
+    let phase = instance.lifecycle.phase;
+    require_retirability(&instance)?;
+    if phase == LifecyclePhase::Running {
+        let drain_tick = cohort.ledger.lock()
+            .map_err(|_| HostBridgeError::State("retirement ledger lock unavailable".to_string()))?
+            .next_logical_tick()?;
+        service.drain(drain_tick)
+            .map_err(|error| HostBridgeError::State(format!("explicit native drain: {error:?}")))?;
+        let drained = service.instance()
+            .map_err(|error| HostBridgeError::State(format!("read drained native instance: {error:?}")))?;
+        if drained.lifecycle.phase != LifecyclePhase::Drained || drained.is_accepting_ingress
+            || !drained.unresolved.is_empty() || !drained.usage.is_idle()
+        {
+            return Err(HostBridgeError::State("native drain did not reach idle Drained with closed ingress".to_string()));
+        }
+    }
+    if phase != LifecyclePhase::Stopped {
+        let shutdown_tick = cohort.ledger.lock()
+            .map_err(|_| HostBridgeError::State("retirement ledger lock unavailable".to_string()))?
+            .next_logical_tick()?;
+        service.stop(shutdown_tick)
+            .map_err(|error| HostBridgeError::State(format!("explicit native shutdown: {error:?}")))?;
+        let stopped = service.instance()
+            .map_err(|error| HostBridgeError::State(format!("read stopped native instance: {error:?}")))?;
+        if stopped.lifecycle.phase != LifecyclePhase::Stopped || stopped.is_accepting_ingress
+            || !stopped.unresolved.is_empty() || !stopped.usage.is_idle()
+        {
+            return Err(HostBridgeError::State("native shutdown did not reach idle Stopped with closed ingress".to_string()));
+        }
+    }
+    service.remove()
+        .map_err(|error| HostBridgeError::State(format!("explicit native removal: {error:?}")))?;
+    if service.host().state().phase != LifecyclePhase::Removed
+        || service.instance().map_err(|error| HostBridgeError::State(format!("read retired native instance: {error:?}")))?.is_accepting_ingress
+    {
+        return Err(HostBridgeError::State("native retirement did not persist Removed".to_string()));
+    }
+    println!("native instance retired: phase=removed, restart_attempts={}, host_operations={}, lattice_exchanges={}, published_reports={}; existing state root preserved", instance.lifecycle.restart_attempts, operations.len(), verified.exchange_revisions.len(), verified.report_revisions.len());
+    Ok(())
+}
+
+fn require_retirability(instance: &molten::system_extension::NativeInstanceRecord) -> Result<()> {
+    let phase = instance.lifecycle.phase;
+    if !matches!(phase, LifecyclePhase::Running | LifecyclePhase::Drained | LifecyclePhase::Stopped)
+        || instance.lifecycle.restart_attempts != MAX_RESTART_ATTEMPTS
+        || !instance.unresolved.is_empty()
+        || !instance.usage.is_idle()
+        || (phase != LifecyclePhase::Running && instance.is_accepting_ingress)
+    {
+        return Err(HostBridgeError::State(
+            "retirement requires exhausted Running, Drained, or Stopped native instance with no unresolved work, closed durable ingress after drain, and idle resources".to_string(),
+        ));
+    }
+    Ok(())
+}
