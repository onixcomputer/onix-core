+            "CREATE TABLE metadata(key TEXT PRIMARY KEY, value TEXT);\
+             CREATE TABLE operations(operation_key TEXT PRIMARY KEY, record_json BLOB, record_hash TEXT);\
+             INSERT INTO metadata(key, value) VALUES ('schema', 'kiln.aspen-host.operation-ledger.v1');",
+        ).expect("historical ledger schema");
+        ledger.execute(
+            "INSERT INTO operations(operation_key, record_json, record_hash) VALUES (?1, ?2, ?3)",
+            rusqlite::params![
+                serde_json::to_string(&record.ingress.operation_id).expect("old operation key"),
+                bytes,
+                blake3::hash(&bytes).to_hex().to_string(),
+            ],
+        ).expect("archived host receipt");
+        drop(ledger);
+        let digest = digest_file(&path).expect("archived ledger digest").to_hex().to_string();
+        let evidence = ArchivedReportEvidence {
+            revision: revision.to_string(),
+            report_blake3: blake3::hash(b"historical report").to_hex().to_string(),
+            log_blake3: blake3::hash(b"historical log").to_hex().to_string(),
+            broker_run_id: "historical-broker-run".to_string(),
+            broker_job_id: "historical-job".to_string(),
+            origin: HistoricalReportOrigin::Aspen {
