diff --git a/src/recovery_preflight.rs b/src/recovery_preflight.rs
new file mode 100644
index 0000000..aacdcc2
--- /dev/null
+++ b/src/recovery_preflight.rs
@@ -0,0 +1,147 @@
+use std::io::Read;
+use std::path::Path;
+
+use molten::system_extension::{
+    LifecyclePhase, NATIVE_INSTANCE_STATE_SCHEMA, decode_native_instance_record,
+};
+use redb::{ReadableDatabase, ReadableTable};
+
+use crate::cohort::MAX_RESTART_ATTEMPTS;
+use crate::durability::{DURABLE_HOST_STATE_SCHEMA, DurableHostStateMarker};
+use crate::error::{HostBridgeError, Result};
+
+const STATE_MARKER_FILE: &str = "host-state.json";
+const NATIVE_JOURNAL_FILE: &str = "native-journal/fabric-durability.redb";
+const OPERATION_LEDGER_FILE: &str = "operation-ledger/operations.sqlite";
+const MARKER_MAXIMUM_BYTES: u64 = 4_096;
+const MACHINE_LOSS_DURABILITY: u8 = 2;
+const LENGTH_PREFIX_BYTES: usize = std::mem::size_of::<u64>();
+const NATIVE_LOG: redb::TableDefinition<u64, &[u8]> =
+    redb::TableDefinition::new("fabric_durable_log_v1");
+
+pub fn check(state_root: &Path) -> Result<()> {
+    if !state_root.is_dir() {
+        return Err(HostBridgeError::State("native preflight requires an existing state root".to_string()));
+    }
+    let marker_path = state_root.join(STATE_MARKER_FILE);
+    let journal_path = state_root.join(NATIVE_JOURNAL_FILE);
+    let ledger_path = state_root.join(OPERATION_LEDGER_FILE);
+    let marker_metadata = match std::fs::symlink_metadata(&marker_path) {
+        Ok(metadata) => metadata,
+        Err(error) if error.kind() == std::io::ErrorKind::NotFound => {
+            if std::fs::symlink_metadata(&journal_path).is_ok()
+                || std::fs::symlink_metadata(&ledger_path).is_ok()
+            {
+                return Err(HostBridgeError::State(
+                    "native preflight refuses a missing marker with existing durable state".to_string(),
+                ));
+            }
+            return Ok(());
+        }
+        Err(error) => return Err(HostBridgeError::Io(format!("inspect native marker: {error}"))),
+    };
+    if !marker_metadata.is_file() {
+        return Err(HostBridgeError::State("native preflight marker is not a regular file".to_string()));
+    }
+    let mut marker_bytes = Vec::new();
+    std::fs::File::open(&marker_path)
+        .map_err(|error| HostBridgeError::Io(format!("open native marker: {error}")))?
+        .take(MARKER_MAXIMUM_BYTES + 1)
+        .read_to_end(&mut marker_bytes)
+        .map_err(|error| HostBridgeError::Io(format!("read native marker: {error}")))?;
+    if marker_bytes.len() as u64 > MARKER_MAXIMUM_BYTES {
+        return Err(HostBridgeError::State("native preflight marker exceeds its bound".to_string()));
+    }
+    let marker: DurableHostStateMarker = serde_json::from_slice(&marker_bytes)
+        .map_err(|error| HostBridgeError::State(format!("decode native marker: {error}")))?;
+    if marker.schema != DURABLE_HOST_STATE_SCHEMA
+        || marker.native_journal_schema != NATIVE_INSTANCE_STATE_SCHEMA
+    {
+        return Err(HostBridgeError::State("native preflight marker schema differs from pinned host".to_string()));
+    }
+    if !std::fs::symlink_metadata(&journal_path)
+        .map_err(|error| HostBridgeError::Io(format!("inspect native journal: {error}")))?
+        .is_file()
+    {
+        return Err(HostBridgeError::State("native preflight journal is not a regular file".to_string()));
+    }
+    let database = redb::Database::builder()
+        .open_read_only(&journal_path)
+        .map_err(|error| HostBridgeError::State(format!("open native journal read-only: {error}")))?;
+    let transaction = database.begin_read()
+        .map_err(|error| HostBridgeError::State(format!("read native journal: {error}")))?;
+    let table = transaction.open_table(NATIVE_LOG)
+        .map_err(|error| HostBridgeError::State(format!("read native log: {error}")))?;
+    let (_sequence, value) = table.last()
+        .map_err(|error| HostBridgeError::State(format!("read latest native record: {error}")))?
+        .ok_or_else(|| HostBridgeError::State("native journal has no instance".to_string()))?;
+    let instance = decode_latest(value.value())?;
+    if matches!(instance.lifecycle.phase,
+        LifecyclePhase::Quarantined | LifecyclePhase::Draining | LifecyclePhase::Drained
+        | LifecyclePhase::ShuttingDown | LifecyclePhase::Stopped | LifecyclePhase::Removed
+    )
+        || matches!(instance.lifecycle.phase, LifecyclePhase::Running | LifecyclePhase::Failed)
+            && instance.lifecycle.restart_attempts >= MAX_RESTART_ATTEMPTS
+    {
+        return Err(HostBridgeError::RecoveryBlocked {
+            phase: instance.lifecycle.phase.as_str(),
+            restart_attempts: instance.lifecycle.restart_attempts,
+            maximum_restart_attempts: MAX_RESTART_ATTEMPTS,
+        });
+    }
+    Ok(())
+}
+
+pub(crate) fn native_log_snapshot(path: &Path) -> Result<molten::system_extension::NativeInstanceRecord> {
+    let database = redb::Database::builder()
+        .open_read_only(path)
+        .map_err(|error| HostBridgeError::State(format!("open native journal read-only: {error}")))?;
+    let transaction = database.begin_read()
+        .map_err(|error| HostBridgeError::State(format!("read native journal: {error}")))?;
+    let table = transaction.open_table(NATIVE_LOG)
+        .map_err(|error| HostBridgeError::State(format!("read native log: {error}")))?;
+    let mut expected_sequence = 0u64;
+    let mut latest = None;
+    for row in table.iter().map_err(|error| HostBridgeError::State(format!("scan native journal: {error}")))? {
+        let (sequence, value) = row
+            .map_err(|error| HostBridgeError::State(format!("read native record: {error}")))?;
+        if sequence.value() != expected_sequence {
+            return Err(HostBridgeError::State("native record sequence is discontinuous".to_string()));
+        }
+        latest = Some(decode_latest(value.value())?);
+        expected_sequence = expected_sequence.checked_add(1)
+            .ok_or_else(|| HostBridgeError::State("native record sequence overflow".to_string()))?;
+    }
+    latest.ok_or_else(|| HostBridgeError::State("native journal has no instance".to_string()))
+}
+
+fn decode_latest(bytes: &[u8]) -> Result<molten::system_extension::NativeInstanceRecord> {
+    if bytes.first().copied() != Some(MACHINE_LOSS_DURABILITY) {
+        return Err(HostBridgeError::State("native record lacks machine-loss durability".to_string()));
+    }
+    let mut offset = 1;
+    let expected_ref = take_blob(bytes, &mut offset)?;
+    let canonical = take_blob(bytes, &mut offset)?;
+    if offset != bytes.len() || expected_ref != format!("blake3:{}", blake3::hash(canonical).to_hex()).as_bytes() {
+        return Err(HostBridgeError::State("native record has invalid canonical identity".to_string()));
+    }
+    decode_native_instance_record(canonical)
+        .map_err(|error| HostBridgeError::State(format!("decode latest native instance: {error}")))
+}
+
+fn take_blob<'a>(bytes: &'a [u8], offset: &mut usize) -> Result<&'a [u8]> {
+    let prefix_end = offset.checked_add(LENGTH_PREFIX_BYTES)
+        .ok_or_else(|| HostBridgeError::State("native record prefix overflow".to_string()))?;
+    let length: [u8; LENGTH_PREFIX_BYTES] = bytes.get(*offset..prefix_end)
+        .ok_or_else(|| HostBridgeError::State("native record prefix is truncated".to_string()))?
+        .try_into()
+        .map_err(|_| HostBridgeError::State("native record prefix has invalid width".to_string()))?;
+    let length = usize::try_from(u64::from_be_bytes(length))
+        .map_err(|_| HostBridgeError::State("native record length overflow".to_string()))?;
+    let end = prefix_end.checked_add(length)
+        .ok_or_else(|| HostBridgeError::State("native record offset overflow".to_string()))?;
+    let blob = bytes.get(prefix_end..end)
+        .ok_or_else(|| HostBridgeError::State("native record blob is truncated".to_string()))?;
+    *offset = end;
+    Ok(blob)
+}
