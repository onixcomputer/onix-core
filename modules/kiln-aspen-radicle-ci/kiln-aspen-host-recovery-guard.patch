+    let radicle = admit_config(radicle_config(
+        directory.path().join("no-lattice-listener.sock"),
+        directory.path().join("lattice-recovery-budget.sqlite"),
+        nix::unistd::getuid().as_raw(),
+    ))
+    .unwrap_or_else(|_| unreachable!("admitted Radicle fixture"));
+    let transport = UnixWorkflowExchange::new(
+        radicle.shell.socket_path.clone(),
+        radicle.transport,
+        radicle.lattice.contract.clone(),
+        radicle.shell.maximum_replay_records,
+    )
+    .unwrap_or_else(|_| unreachable!("admitted Lattice transport"));
