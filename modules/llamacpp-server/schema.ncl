{
  server = {
    host = { type = "string", default = "0.0.0.0", description = "Address llama-server binds to" },
    port = { type = "port", default = 13305, description = "OpenAI-compatible llama-server API port" },
    backend = { type = "enum", values = ["cuda", "rocm", "rocm-dspark", "vulkan", "cpu", "metalium"], default = "cuda", description = "llama.cpp acceleration backend" },
    modelRepo = { type = "string", description = "Hugging Face repository containing the GGUF model" },
    modelFile = { type = "string", description = "GGUF filename to download from modelRepo" },
    modelRevision = { type = "string", default = "main", description = "Hugging Face revision or branch for the model file" },
    extraModelFiles = { type = "array_string", default = [], description = "Additional files to download from modelRepo, such as remaining GGUF shards" },
    draftModelSource = { type = "enum", values = ["download", "package"], default = "download", description = "Draft GGUF origin: Hugging Face download or the Nix-built deepseek-v4-dspark-draft package" },
    draftModelRepo = { type = "string", default = "", description = "Hugging Face repository containing the optional speculative draft GGUF" },
    draftModelFile = { type = "string", default = "", description = "Draft GGUF filename to download from draftModelRepo; empty disables speculative decoding" },
    draftModelRevision = { type = "string", default = "main", description = "Hugging Face revision or branch for the draft model file" },
    modelAlias = { type = "nullable_string", default = null, description = "Optional model alias exposed by llama-server" },
    gpuLayers = { type = "number", default = 999, description = "Number of layers to offload to the GPU" },
    metaliumDeviceId = { type = "number", default = 0, description = "Physical Tenstorrent device isolated with TT_VISIBLE_DEVICES for the Metalium backend" },
    metaliumInspectorPort = { type = "port", default = 50051, description = "Loopback TT-Metal inspector RPC port reserved for this service" },
    metaliumTrace = { type = "bool", default = false, description = "Opt into experimental Metalium command-trace capture and replay" },
    contextSize = { type = "number", default = 8192, description = "Context window size" },
    generationThreads = { type = "number", default = 0, description = "Optional llama.cpp generation worker count passed with --threads (0 uses the backend default)" },
    batchThreads = { type = "number", default = 0, description = "Optional llama.cpp prompt/batch worker count passed with --threads-batch (0 uses the generation worker count)" },
    batchSize = { type = "number", default = 0, description = "Optional llama.cpp batch size passed with -b (0 disables the flag)" },
    ubatchSize = { type = "number", default = 0, description = "Optional llama.cpp physical batch size passed with -ub (0 disables the flag)" },
    parallelSlots = { type = "number", default = 0, description = "Optional llama.cpp parallel slot count passed with -np (0 disables the flag)" },
    cacheTypeK = { type = "nullable_string", default = null, description = "Optional K-cache quantization type" },
    cacheTypeV = { type = "nullable_string", default = null, description = "Optional V-cache quantization type" },
    flashAttention = { type = "bool", default = true, description = "Enable llama.cpp flash attention" },
    gpuPerformanceLock = { type = "bool", default = false, description = "Lock the ACPI platform profile to performance and the Radeon performance level to high for deterministic inference clocks" },
    noMmap = { type = "bool", default = true, description = "Disable mmap model loading" },
    enableMetrics = { type = "bool", default = true, description = "Expose llama-server metrics" },
    autoStart = { type = "bool", default = true, description = "Start the service on boot" },
    extraArgs = { type = "array_string", default = [], description = "Additional llama-server arguments" },
  },
}
