+/// Mesh-LLM rejects a plugin whose initialize response names anything other
+/// than its configured entry, and passes that name as `MESH_LLM_PLUGIN_NAME`.
+/// Reporting it lets several named entries share this binary.
+fn plugin_name(assigned: Option<String>) -> String {
+    assigned
+        .map(|value| value.trim().to_string())
+        .filter(|value| !value.is_empty())
+        .unwrap_or_else(|| PLUGIN_ID.to_string())
+}
