+fn normalize_join_token_contents(contents: &str) -> Result<String, JoinTokenContentError> {
+    let token = contents
+        .strip_suffix("\r\n")
+        .or_else(|| contents.strip_suffix('\n'))
+        .unwrap_or(contents);
+    if token.is_empty() {
+        return Err(JoinTokenContentError::Empty);
+    }
+    if token.chars().any(char::is_whitespace) {
+        return Err(JoinTokenContentError::ContainsWhitespace);
+    }
+    Ok(token.to_owned())
+}
