# Clan instance nix-cache (inventory/services/services.ncl): uploader role.
# The server role on aspen1 is not ported.
let uploader = fun local_address =>
  {
    settings.maintenance_guard_urls = [
      "http://%{local_address}:39000/health",
      "http://%{local_address}:39200/__celld/health",
    ],
  }
in
{
  nix-cache = {
    service = "niks3",
    roles.uploader = {
      settings = {
        server_url = "http://100.100.103.95:39400",
        automatic_uploads = false,
        maintenance_marker = "/run/niks3-maintenance-window",
        batch_size = 1,
        idle_exit_timeout_seconds = 0,
        max_concurrent_uploads = 1,
        verify_s3_integrity = true,
        # vars/shared/niks3-nix-cache-storage/signing-key-public/value,
        # generated by the server role on aspen1.
        trusted_public_key = "onix-niks3-1:1Vg2qs7firQQJ/08DpDIXVBY41v6gPbHuwQlqr7EoQU=",
        # Every uploader has tag prometheus (node exporter).
        queue_metrics = true,
      },
      machines = {
        aspen1 = uploader "100.100.103.95",
        # Aspen2 has no Celld authority; its manual drain checks Aspen1.
        aspen2 = uploader "100.100.103.95",
        aspen3 = uploader "100.108.13.4",
        britton-desktop = uploader "100.110.43.11",
      },
    },
  },
}
