# Aspen2's retained vLLM/Ray network configuration. Aspen2 has no RDMA
# controller, so this host module intentionally supports only the Thunderbolt
# TCP network; NixOS keeps its separate hardware-backed RDMA selector.
fun onix =>
  let policy = import "../../inventory/tags/vllm-cluster-network.json" in
  let thunderbolt = import "../../inventory/tags/thunderbolt-link.json" in
  let host_impl = fun args =>
    let p = args.package_paths in
    let machine = args.machine_name in
    if machine != "aspen2" then
      std.fail_with "vllm-cluster-network: retained systemd-host implementation supports only aspen2 (Thunderbolt TCP; no RDMA controller)"
    else
      let node = std.record.get machine policy.clusterNodes in
      let head_ip = std.record.get policy.headHost thunderbolt.tbAddresses in
      let local_ip = std.record.get machine thunderbolt.tbAddresses in
      let env = m%"
        # Generated by inventory/tags/vllm-cluster-network.json.
        # Source this file before starting Ray/vLLM, or run commands via vllm-cluster-env.
        # RDMA-capable network controller found in the hardware inventory: no.
        VLLM_CLUSTER_BACKEND=%{policy.thunderboltBackend}
        VLLM_CLUSTER_TRANSPORT=%{policy.thunderboltTransport}
        VLLM_CLUSTER_INTERFACE=%{policy.thunderboltInterface}
        VLLM_CLUSTER_HOST=%{machine}
        VLLM_CLUSTER_ROLE=%{node.role}
        VLLM_CLUSTER_HEAD_HOST=%{policy.headHost}
        VLLM_CLUSTER_HEAD_IP=%{head_ip}
        VLLM_CLUSTER_LOCAL_IP=%{local_ip}
        VLLM_CLUSTER_RAY_PORT=%{std.to_string policy.rayPort}
        RAY_ADDRESS=%{head_ip}:%{std.to_string policy.rayPort}
        RAY_NODE_IP_ADDRESS=%{local_ip}
        VLLM_HOST_IP=%{local_ip}
        NCCL_SOCKET_IFNAME=%{policy.thunderboltInterface}
        GLOO_SOCKET_IFNAME=%{policy.thunderboltInterface}
        TP_SOCKET_IFNAME=%{policy.thunderboltInterface}
        NCCL_IB_DISABLE=%{policy.thunderboltNcclIbDisable}
      "%
      in
      {
        output.host = {
          packages = [p."vllm-cluster-env"],
          files."vllm-cluster/network.env".text = env,
        },
      }
  in
  ({
    interface = {
      manifest = {
        name = "onix-core/vllm-cluster-network",
        description = "Aspen2 vLLM/Ray Thunderbolt TCP environment and command wrapper.",
        categories = ["network"],
      },
      portability = {
        status = 'platform_specific,
        platform_leaves = [
          {
            namespace = "host",
            targets = ["onixos"],
            rationale = "Aspen2 uses its configured Thunderbolt bridge; this retained-host implementation does not provide RDMA",
          },
        ],
      },
      packages = ["vllm-cluster-env"],
      roles.host = {},
    },
    impl = host_impl,
  }
  ) | onix.ServiceModule
