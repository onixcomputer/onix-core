# Canonical typed source for the accepted Aspen1 Radicle CI deployment receipt.
# Export with: nickel export --format json evidence/radicle/ci-deployment-v1.ncl
let Digest = String
in
let Job = {
  job_id | Digest,
  object_oid | String,
  trigger | String,
  disposition | String,
  event_blake3 | Digest,
  result_blake3 | Digest,
  artifact_blake3 | Digest,
}
