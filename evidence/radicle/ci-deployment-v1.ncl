      bot_role | String,
      runner_role | String,
      runner_credentials | String,
      runner_private_network | Bool,
      runner_protect_system | String,
      runner_memory_max_bytes | Number,
      runner_tasks_max | Number,
      forbidden_authorities | Array String,
    },
  monitoring
    | {
      prometheus | String,
      systemd_exporter | String,
      ci_node | String,
      ci_sync_timer | String,
      alert | String,
    },
  evidence_hashes
    | {
      patch_artifact_json | Digest,
      isolation_probe_json | Digest,
      bounds_probe_json | Digest,
    },
  evidence | Array String,
  non_claims | Array String,
}
